[Unit]
Description=Snook per-user local workspace daemon
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
# Use the same LocalApplicationData default as the desktop and CLI.
# Custom workspace/port settings belong in a per-user drop-in.
ExecStart=/usr/bin/snookd
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
