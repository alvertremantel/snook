<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snook.UI"
        x:Class="Snook.UI.WorkspaceView"
        x:CompileBindings="False">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/NavigationIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="TaskPickerTemplate" x:DataType="local:TaskPickerEntry" x:CompileBindings="True">
        <StackPanel Spacing="3" MaxWidth="330" Margin="0,3">
          <TextBlock Text="{Binding Name}" Classes.picker-heading="{Binding IsHeader}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Context}" IsVisible="{Binding HasContext}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.lane-count"><Setter Property="Grid.Column" Value="1" /></Style>
    <Style Selector="Button.lane-star"><Setter Property="Grid.Column" Value="2" /></Style>
    <Style Selector="Button.lane-actions"><Setter Property="Grid.Column" Value="3" /></Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.lane-title"><Setter Property="Grid.ColumnSpan" Value="4" /></Style>
    <Style Selector="local|WorkspaceView.narrow TextBlock.lane-count">
      <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow Button.lane-star"><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector="local|WorkspaceView.narrow Button.lane-actions"><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector="StackPanel.agenda-time"><Setter Property="Grid.Column" Value="2" /></Style>
    <Style Selector="StackPanel.agenda-actions"><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.agenda-title"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.agenda-time">
      <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.agenda-actions"><Setter Property="Grid.Row" Value="2" /></Style>
    <Style Selector="local|WorkspaceView.narrow local|ReportRowGrid">
      <Setter Property="IsNarrow" Value="True" />
    </Style>
    <Style Selector="StackPanel.history-start">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="StackPanel.history-duration">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.history-edit">
      <Setter Property="Grid.Column" Value="3" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.history-title">
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.history-start">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.history-duration">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow Button.history-edit">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="StackPanel.summary-attributed">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="StackPanel.summary-coverage">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.summary-label">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.summary-attributed">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.summary-coverage">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.mobile-metric-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow TextBlock.mobile-metric-label">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow Grid.desktop-table-heading">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.tracker-state">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow TextBlock.tracker-state">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow TextBlock.tracker-label">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="StackPanel.rail-item">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="local|WorkspaceView.medium StackPanel.rail-item">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Spacing" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|WorkspaceView.medium StackPanel.rail-item TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="72" />
    </Style>
    <Style Selector="local|WorkspaceView.medium Button.nav">
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Height" Value="64" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="48" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow ComboBox">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow TextBox">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow Button.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="local|WorkspaceView.medium Button.nav.selected">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="StackPanel.today-task-actions">
      <Setter Property="Grid.Column" Value="3" />
    </Style>
    <Style Selector="StackPanel.task-row-actions">
      <Setter Property="Grid.Column" Value="3" />
    </Style>
    <Style Selector="TextBlock.task-row-priority">
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.task-row-title">
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.task-row-actions">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow TextBlock.task-row-priority">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="local|WorkspaceView.narrow StackPanel.today-task-actions">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
    <Style Selector="ComboBox.structured-picker ComboBoxItem" x:DataType="local:TaskPickerEntry" x:CompileBindings="True">
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
    </Style>
    <Style Selector="TextBlock.picker-heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="WorkspaceLayout" ColumnDefinitions="196,*" RowDefinitions="*,Auto">
    <Border x:Name="WorkspaceSidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="16,26">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34">
              <TextBlock Text="S" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="SidebarWordmark" Text="snook" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="SidebarTagline" Text="A quiet place for doing" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12" Margin="2,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="2">
          <TextBlock x:Name="SidebarWorkspaceHeading" Text="WORKSPACE" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" Margin="14,0,0,10" />
          <Button Classes="nav" Classes.selected="{Binding IsTodayVisible}" AutomationProperties.Name="Today" Command="{Binding SelectSectionCommand}" CommandParameter="Today">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource TodayNavigationIcon}" />
              <TextBlock Text="Today" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsTasksVisible}" AutomationProperties.Name="Tasks" Command="{Binding SelectSectionCommand}" CommandParameter="Tasks">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource TasksNavigationIcon}" />
              <TextBlock Text="Tasks" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:DataType="local:MainWindowViewModel" x:CompileBindings="True" Classes="nav" Classes.selected="{Binding IsHabitsVisible}" AutomationProperties.Name="Habits" Command="{Binding SelectSectionCommand}" CommandParameter="Habits">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource HabitsNavigationIcon}" />
              <TextBlock Text="Habits" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:DataType="local:MainWindowViewModel" x:CompileBindings="True" Classes="nav" Classes.selected="{Binding IsJournalsVisible}" AutomationProperties.Name="Journals" Command="{Binding SelectSectionCommand}" CommandParameter="Journals">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource JournalsNavigationIcon}" />
              <TextBlock Text="Journals" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsTimeTrackerVisible}" AutomationProperties.Name="Time Tracker" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource TrackerNavigationIcon}" />
              <TextBlock Text="Time Tracker" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsCalendarVisible}" AutomationProperties.Name="Calendar" Command="{Binding SelectSectionCommand}" CommandParameter="Calendar">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource CalendarNavigationIcon}" />
              <TextBlock Text="Calendar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsHistoryVisible}" AutomationProperties.Name="History" Command="{Binding SelectSectionCommand}" CommandParameter="History">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource HistoryNavigationIcon}" />
              <TextBlock Text="History" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSummaryVisible}" AutomationProperties.Name="Summary" Command="{Binding SelectSectionCommand}" CommandParameter="Summary">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource SummaryNavigationIcon}" />
              <TextBlock Text="Summary" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="SidebarManageHeading" Text="MANAGE" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" Margin="14,12,0,8" />
          <Button Classes="nav" Classes.selected="{Binding IsSettingsVisible}" AutomationProperties.Name="Settings" Command="{Binding SelectSectionCommand}" CommandParameter="Settings">
            <StackPanel Classes="rail-item">
              <ContentControl Theme="{StaticResource SettingsNavigationIcon}" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        </ScrollViewer>
        <Border x:Name="SidebarTimer" Grid.Row="2" Background="{DynamicResource SidebarRaisedBrush}" CornerRadius="12" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding WorkspaceName}" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding PrimarySession.Label}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="{Binding PrimarySession.ElapsedLabel}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="23" FontWeight="Light" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="{Binding PrimarySession.StateLabel}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="No focus timer running" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNoFocusSessions}" />
            <Button Classes="ghost sidebar-action" Content="Open tracker →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceContent" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,28,28,16">
      <Grid x:Name="WorkspaceHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="7">
          <TextBlock Text="{Binding CurrentSection}" Classes="eyebrow" />
          <TextBlock x:Name="WorkspaceTitle" Text="{Binding SectionTitle}" Classes="title" TextWrapping="Wrap" />
          <TextBlock x:Name="WorkspaceSubtitle" Text="{Binding SectionSubtitle}" Classes="muted" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="WorkspaceSearch" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" IsVisible="{Binding HasPageSearch}">
            <TextBox AutomationProperties.Name="{Binding SearchHint}" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding SearchHint}" BorderThickness="0" Background="Transparent" Width="190" />
          </Border>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22">
        <StackPanel Spacing="22" IsVisible="{Binding IsTodayVisible}">
          <TextBlock Text="{Binding TodayOverview}" Classes="muted" FontSize="12" />

          <Border Classes="card" Background="{DynamicResource PausedSurfaceBrush}" IsVisible="{Binding HasRecoverySessions}">
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="RECOVERY NEEDED" Classes="eyebrow" Foreground="{DynamicResource PausedBrush}" />
                <TextBlock Text="A timer boundary needs your decision." Foreground="{DynamicResource PausedBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Snook did not invent uncertain time. Choose how to resolve each item." Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding RecoverySessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource PausedSurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,2,0,0">
                      <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding IdentityLabel}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ReasonLabel}" Foreground="{DynamicResource PausedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding RecordedTimeLabel}" IsVisible="{Binding IsRestored}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DecisionHelp}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="ghost" Content="Last known" Command="{Binding StopAtLastKnownCommand}" AutomationProperties.Name="{Binding LastKnownAutomationName}" />
                          <Button Classes="ghost" Content="Stop now" Command="{Binding StopNowCommand}" AutomationProperties.Name="{Binding StopNowAutomationName}" />
                          <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" AutomationProperties.Name="{Binding ContinueAutomationName}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid x:Name="TodayPrimaryLayout" ColumnDefinitions="*,1.15*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="22" RowSpacing="14">
<Border x:Name="TodayCaptureCard" Grid.Column="0" Grid.Row="0" Classes="card" Background="{DynamicResource AccentSoftBrush}" Padding="20">
                <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="QUICK CAPTURE" Classes="eyebrow" />
                    <TextBlock Text="Put it somewhere useful." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>

                </Grid>
                <TextBox AutomationProperties.Name="New task title" Text="{Binding TaskTitle, Mode=TwoWay}" KeyDown="OnTaskCaptureKeyDown" PlaceholderText="What needs doing?" CornerRadius="9" Padding="12" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ComboBox Classes="structured-picker" AutomationProperties.Name="Task project" ItemsSource="{Binding CaptureProjectOptions}" SelectedValue="{Binding SelectedProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" ItemTemplate="{StaticResource TaskPickerTemplate}" PlaceholderText="Choose a project" Padding="10" />
                  <Button Grid.Column="1" Classes="primary" AutomationProperties.Name="Add task" Content="Add task" Command="{Binding CreateTaskCommand}" />
                </Grid>
                <TextBlock Text="Capture a thought now. Add the details when you’re ready." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                </Border>
<Border x:Name="TodayFocusCard" Grid.Column="1" Grid.Row="0" Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="CURRENTLY TRACKING" Classes="eyebrow" />
                  <TextBlock Text="Your focus, right now." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox AutomationProperties.Name="Dashboard activity" ItemsSource="{Binding Activities}" SelectedValue="{Binding SelectedTrackingActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose activity" />
                  <Button Grid.Column="1" Classes="primary" AutomationProperties.Name="Start or switch activity" Content="Start / switch" Command="{Binding StartSelectedActivityCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding SessionCountLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="All timers →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TodayFocusSessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding LaneLabel}" />  ·  <Run Text="{Binding StateLabel}" /></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedLabel}" FontFamily="monospace" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Classes="ghost" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                            <Button Classes="ghost" Content="Stop" Command="{Binding StopCommand}" AutomationProperties.Name="Stop timer" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="12" IsVisible="{Binding HasNoFocusSessions}">
                  <TextBlock Text="Ready when you are. Choose an activity above, or start a task below." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
<Border x:Name="TodayNextCard" Grid.Column="1" Grid.Row="1" Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="YOUR NEXT TASKS" Classes="eyebrow" />
                  <TextBlock Text="Choose one thing to move forward." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="View all  →" Command="{Binding SelectSectionCommand}" CommandParameter="Tasks" />
              </Grid>
              <ItemsControl ItemsSource="{Binding TodayNextTasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid Classes="today-task-row" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="13" RowSpacing="8">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Width="22" Height="22" VerticalAlignment="Center">
                          <TextBlock Text="○" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding ProjectName}" />  ·  <Run Text="{Binding DueLabel}" /></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding PriorityLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Classes="today-task-actions" Orientation="Horizontal" Spacing="5">
                          <Button Classes="ghost" Content="Start" Command="{Binding StartCommand}" />
                          <Button Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding CompleteCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nothing queued here. Capture a next step, or open your task board." Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasNoTodayNextTasks}" />
            </StackPanel>
          </Border>
<Border x:Name="TodayAgendaCard" Grid.Column="0" Grid.Row="1" Classes="card" Padding="20">
                <StackPanel Spacing="14">
                <TextBlock Text="ON THE HORIZON" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayAgendaPreview}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2,0,0,0" Padding="12,4" Margin="0,4">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No upcoming plans. Leave some room, or add a block in Calendar." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoTodayUpcomingRows}" />
                </StackPanel>
                </Border>
          </Grid>


          <Grid x:Name="TodaySecondaryLayout" ColumnDefinitions="*,1.15*" RowDefinitions="Auto,Auto" ColumnSpacing="22">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="RECENTLY TRACKED" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayRecentRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No recent tracked work." Classes="muted" IsVisible="{Binding HasNoTodayRecentRows}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="UP NEXT" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayUpcomingRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No upcoming deadlines or schedule." Classes="muted" IsVisible="{Binding HasNoTodayUpcomingRows}" />
              </StackPanel>
            </Border>
          </Grid>
                <Button Classes="secondary" Content="+ Add manual time" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="manual" />
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsTasksVisible}">
          <Border x:Name="TaskWorkspaceCard" Classes="card">
            <StackPanel Spacing="14">
              <Grid x:Name="TaskToolbarLayout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <WrapPanel Classes="editor" Orientation="Horizontal">
                  <Button x:Name="TaskListViewButton" Classes="ghost" Classes.selected="{Binding IsTaskListVisible}" AutomationProperties.Name="Show tasks as list" Content="List" Command="{Binding SelectTaskViewCommand}" CommandParameter="List" />
                  <Button Classes="ghost" Classes.selected="{Binding IsTaskBoardVisible}" AutomationProperties.Name="Show tasks as board" Content="Board" Command="{Binding SelectTaskViewCommand}" CommandParameter="Board" />
                  <ComboBox ItemsSource="{Binding TaskSortOptions}" SelectedValue="{Binding TaskSortMode, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" Width="130" PlaceholderText="Sort" />
                  <Button Classes="ghost" Content="{Binding TaskFilterLabel}" AutomationProperties.Name="Task filters">
                    <Button.Flyout><Flyout><StackPanel Spacing="10" MinWidth="200">
                      <TextBlock Text="INCLUDE IN THIS VIEW" Classes="eyebrow" />
                      <CheckBox Content="Completed tasks" IsChecked="{Binding ShowCompleted, Mode=TwoWay}" />
                      <CheckBox Content="Archived tasks" IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
                      <CheckBox Content="Deleted tasks" IsChecked="{Binding ShowDeleted, Mode=TwoWay}" />
                    </StackPanel></Flyout></Button.Flyout>
                  </Button>
                </WrapPanel>
                <Button x:Name="BoardCreationButton" Grid.Column="1" Classes="icon" Content="+ New board / project" AutomationProperties.Name="New board or project">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" Opened="OnBoardCreationOpened">
                      <StackPanel x:Name="BoardCreationForm" Width="340" Spacing="16" KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel Spacing="8">
                          <TextBlock Text="NEW BOARD" Classes="eyebrow" />
                          <TextBox AutomationProperties.Name="Tasks screen new board name" Text="{Binding NewBoardName, Mode=TwoWay}" PlaceholderText="Board name" />
                          <Button Classes="primary" AutomationProperties.Name="Create board from Tasks" Content="Add board" Command="{Binding CreateBoardCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Spacing="8">
                          <TextBlock Text="NEW PROJECT" Classes="eyebrow" />
                          <ComboBox AutomationProperties.Name="Tasks screen project board" ItemsSource="{Binding Boards}" SelectedValue="{Binding SelectedBoardId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose board" />
                          <TextBox AutomationProperties.Name="Tasks screen new project name" Text="{Binding NewProjectName, Mode=TwoWay}" PlaceholderText="Project name" />
                          <Button Classes="primary" AutomationProperties.Name="Create project from Tasks" Content="Add project" Command="{Binding CreateProjectCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="340" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
               <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="12">
                 <StackPanel Spacing="12">

                   <Grid x:Name="TaskCaptureLayout" ColumnDefinitions="*,180,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                     <TextBox x:Name="TaskCaptureTitle" AutomationProperties.Name="Tasks screen new task title" Text="{Binding TaskTitle, Mode=TwoWay}" KeyDown="OnTaskCaptureKeyDown" PlaceholderText="What needs doing?" Padding="9" />
                     <ComboBox x:Name="TaskCaptureProject" Grid.Column="1" Classes="structured-picker" AutomationProperties.Name="Tasks screen task project" ItemsSource="{Binding CaptureProjectOptions}" SelectedValue="{Binding SelectedProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" ItemTemplate="{StaticResource TaskPickerTemplate}" PlaceholderText="Project" Padding="9" />
                     <Button x:Name="TaskCaptureAdd" Grid.Column="2" Classes="primary" AutomationProperties.Name="Create task from Tasks" Content="Add task" Command="{Binding CreateTaskCommand}" />
                   </Grid>
                 </StackPanel>
               </Border>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                <ScrollViewer x:Name="BoardTabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding BoardTabs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BoardTab" x:CompileBindings="True">
                      <Button Classes="tab" Classes.selected="{Binding IsSelected}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}" MaxWidth="220" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).SelectTaskBoardCommand}" CommandParameter="{Binding Id}" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="1" Classes="ghost" Content="•••" AutomationProperties.Name="Selected board actions" IsVisible="{Binding HasSelectedTaskBoard}">
                  <Button.Flyout><Flyout><StackPanel Spacing="6" MinWidth="200" DataContext="{Binding SelectedTaskBoardAdmin}">
                    <TextBlock Text="{Binding Board.Name}" Classes="eyebrow" TextWrapping="Wrap" />
                    <Button Classes="ghost" Content="Rename board" Click="OnRenameWorkspaceItem" />
                    <Button Classes="ghost" Content="Move board earlier" Command="{Binding MoveEarlierCommand}" Click="OnWorkspaceActionClick" />
                    <Button Classes="ghost" Content="Move board later" Command="{Binding MoveLaterCommand}" Click="OnWorkspaceActionClick" />
                    <Button Classes="danger" Content="Delete board" Command="{Binding DeleteCommand}" Click="OnWorkspaceActionClick" />
                  </StackPanel></Flyout></Button.Flyout>
                </Button>
                <Button Grid.Column="2" Classes="ghost" Content="←" Click="OnBoardTabsPrevious" AutomationProperties.Name="Previous boards" />
                <Button Grid.Column="3" Classes="ghost" Content="→" Click="OnBoardTabsNext" AutomationProperties.Name="Next boards" />
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="tab" Classes.selected="{Binding ShowAllTasks}" Content="All tasks" Command="{Binding SelectTaskScopeCommand}" CommandParameter="All" />
                <Button Classes="tab" Classes.selected="{Binding ShowStarredTasks}" Content="★ Starred" AutomationProperties.Name="Show starred tasks and projects" Command="{Binding SelectTaskScopeCommand}" CommandParameter="Starred" Margin="6,0,16,0" />
                <Button Classes="ghost" Content="Select all in view" Command="{Binding SelectAllTasksCommand}" AutomationProperties.Name="Select all tasks in view" />
                <TextBlock Text="{Binding TaskSelectionLabel}" VerticalAlignment="Center" Margin="8,0" />
                <Button Classes="primary" Content="Edit selected" Command="{Binding OpenBulkTaskEditorCommand}" IsEnabled="{Binding HasSelectedTasks}" AutomationProperties.Name="Edit selected tasks" />
                <Button Classes="ghost" Content="Clear" Command="{Binding ClearTaskSelectionCommand}" IsEnabled="{Binding HasSelectedTasks}" AutomationProperties.Name="Clear task selection" Margin="6,0,0,0" />
              </WrapPanel>
              <StackPanel IsVisible="{Binding ShowStarredTasks}" Spacing="6">
                <TextBlock Text="Starred tasks and all tasks in starred projects" Classes="muted" FontSize="12" />
                <ItemsControl ItemsSource="{Binding StarredProjects}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ProjectAdminRowViewModel">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                      <Button Classes="ghost" Content="★" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).ToggleProjectStarCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding StarLabel}" ToolTip.Tip="{Binding StarLabel}" />
                      <Button Classes="ghost" Content="{Binding Project.Name}" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="This board has no projects yet. Use + New board / project to add its first project." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasEmptyTaskBoard}" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsTaskBoardVisible}">
                <ComboBox x:Name="BoardProjectJump" IsVisible="{Binding IsTaskBoardVisible}" ItemsSource="{Binding TaskGroups}" DisplayMemberBinding="{Binding ProjectName}" PlaceholderText="Jump to a project" SelectionChanged="OnBoardProjectSelected" AutomationProperties.Name="Jump to board project" MaxWidth="280" HorizontalAlignment="Left" />
                <Button x:Name="BoardPreviousButton" Grid.Column="1" IsVisible="{Binding IsTaskBoardVisible}" Classes="ghost" Content="←" Click="OnBoardPrevious" AutomationProperties.Name="Previous project lanes" />
                <Button x:Name="BoardNextButton" Grid.Column="2" IsVisible="{Binding IsTaskBoardVisible}" Classes="ghost" Content="→" Click="OnBoardNext" AutomationProperties.Name="Next project lanes" />
              </Grid>
              <ItemsControl ItemsSource="{Binding WorkspaceTasks}" IsVisible="{Binding IsTaskListVisible}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="catalog-row" Classes.selected="{Binding IsSelected}" Padding="0,16">
                      <Grid Classes="task-list-row" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                          <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding SelectionLabel}" ToolTip.Tip="Select for bulk editing" />
                          <Button Classes="ghost" Content="{Binding CompletionGlyph}" AutomationProperties.Name="{Binding ActionLabel}" ToolTip.Tip="{Binding ActionLabel}" Command="{Binding CompleteCommand}" Padding="6" />
                        </StackPanel>
                        <StackPanel Classes="task-row-title" Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"><Run Text="{Binding ProjectName}" />  ·  <Run Text="{Binding DueLabel}" />  ·  <Run Text="{Binding TrackedLabel}" /></TextBlock>
                        </StackPanel>
                        <TextBlock Classes="task-row-priority" Text="{Binding PriorityLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Classes="task-row-actions" Orientation="Horizontal" Spacing="5">
                          <Button Classes="ghost" Content="{Binding StarGlyph}" AutomationProperties.Name="{Binding StarLabel}" ToolTip.Tip="{Binding StarLabel}" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).ToggleTaskStarCommand}" CommandParameter="{Binding}" Padding="6" />
                          <Button Classes="icon" Content="Start" Command="{Binding StartCommand}" />
                          <Button Classes="ghost" Content="Edit" AutomationProperties.Name="Edit task" Command="{Binding ShowDetailsCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTaskBoardVisible}">
              <ItemsControl ItemsSource="{Binding TaskGroups}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="project-lane" CornerRadius="11" Padding="12" Width="{Binding $parent[local:WorkspaceView].BoardLaneWidth}" MinHeight="330" Margin="0,0,14,12">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6" Margin="4,4">
                          <StackPanel Classes="lane-title" Spacing="4"><TextBlock Text="{Binding BoardName}" Classes="eyebrow" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                          <TextBlock Text="{Binding CountLabel}" Classes="muted lane-count" />
                          <Button Classes="ghost lane-star" Content="{Binding Admin.StarGlyph}" Padding="5" AutomationProperties.Name="{Binding Admin.StarLabel}" ToolTip.Tip="{Binding Admin.StarLabel}" IsVisible="{Binding CanManage}" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).ToggleProjectStarCommand}" CommandParameter="{Binding Admin}" />
                          <Button Classes="ghost lane-actions" Content="More" Padding="6" AutomationProperties.Name="Project lane actions" IsVisible="{Binding CanManage}">
                            <Button.Flyout><Flyout><StackPanel Spacing="6" MinWidth="200" DataContext="{Binding Admin}">
                              <TextBlock Text="{Binding Project.Name}" Classes="eyebrow" TextWrapping="Wrap" />
                              <Button Classes="ghost" Content="{Binding StarLabel}" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).ToggleProjectStarCommand}" CommandParameter="{Binding}" Click="OnWorkspaceActionClick" />
                              <Button Classes="ghost" Content="Rename project" Click="OnRenameWorkspaceItem" />
                              <Button Classes="ghost" Content="Move project earlier" Command="{Binding MoveEarlierCommand}" Click="OnWorkspaceActionClick" />
                              <Button Classes="ghost" Content="Move project later" Command="{Binding MoveLaterCommand}" Click="OnWorkspaceActionClick" />
                              <Button Classes="danger" Content="Delete project" Command="{Binding DeleteCommand}" Click="OnWorkspaceActionClick" />
                            </StackPanel></Flyout></Button.Flyout>
                          </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="task-card" Classes.selected="{Binding IsSelected}" Padding="14" Margin="0,0,0,12">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                  <CheckBox Content="Select" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding SelectionLabel}" FontSize="11" />
                                  <Button Grid.Column="1" Classes="ghost" Content="{Binding StarGlyph}" AutomationProperties.Name="{Binding StarLabel}" ToolTip.Tip="{Binding StarLabel}" Command="{Binding $parent[local:WorkspaceView].((local:MainWindowViewModel)DataContext).ToggleTaskStarCommand}" CommandParameter="{Binding}" Padding="6,2" />
                                </Grid>
                                <Border Classes="drag-handle" Background="Transparent" Cursor="Hand" PointerPressed="OnCardPressed" PointerMoved="OnCardMoved" PointerReleased="OnCardReleased" PointerCaptureLost="OnCardCaptureLost" ToolTip.Tip="Drag to another project. You can also use Move below.">
                                <StackPanel Spacing="8">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding PriorityLabel}" Classes="eyebrow" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="⠿" Classes="muted" />
                                  </Grid>
                                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding DueLabel}" />  ·  <Run Text="{Binding TrackedLabel}" /></TextBlock>
                                </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                  <Button Classes="icon" Content="Start" Command="{Binding StartCommand}" />
                                  <Button Grid.Column="1" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit task" Command="{Binding ShowDetailsCommand}" />
                                  <Button Grid.Column="2" Classes="ghost" Content="{Binding CompletionGlyph}" AutomationProperties.Name="{Binding ActionLabel}" ToolTip.Tip="{Binding ActionLabel}" Command="{Binding CompleteCommand}" />
                                </Grid>
                              </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Drop a task here" Classes="muted" HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsEmpty}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="No tasks match this view." Classes="muted" IsVisible="{Binding HasNoWorkspaceTasks}" />

            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="18" IsVisible="{Binding IsTimeTrackerVisible}">
          <Grid x:Name="TrackerToolbar" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button x:Name="TrackerLibraryButton" Classes="ghost" Content="Activity library →" Command="{Binding OpenActivityLibraryCommand}" HorizontalAlignment="Left" />
            <Button x:Name="TrackerManualButton" Grid.Column="1" Classes="secondary" Content="+ Manual time" AutomationProperties.Name="Add manual time" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="manual" />
            <Button x:Name="TrackerNewButton" Grid.Column="2" Classes="primary" Content="+ New activity" AutomationProperties.Name="New activity" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="activity" />
          </Grid>
          <Grid x:Name="TrackerLayout" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="18">
            <ScrollViewer x:Name="TrackerActivitiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="ACTIVITIES" Classes="eyebrow" />
                <TextBlock Text="Choose where your time goes" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding TrackerGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Padding="16" Margin="0,0,0,14">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Activities}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="activity" Classes.selected="{Binding IsRunning}" Command="{Binding StartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,3" ToolTip.Tip="{Binding DescriptionToolTip}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LaneLabel}" Classes="muted" FontSize="11" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No activities here yet. Create an activity above, or restore one in the activity library." TextWrapping="Wrap" Classes="muted" IsVisible="{Binding HasNoTrackerActivities}" />
            </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="TrackerSessionsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="IN PROGRESS" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="{Binding SessionCountLabel}" Classes="muted" FontSize="12" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FocusSessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="22,18" Margin="0,0,0,12">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="tracker-label" Text="{Binding Label}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Classes="tracker-state" Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontSize="12" />
                          </Grid>
                          <TextBlock Text="{Binding ElapsedLabel}" Foreground="{Binding AccentColor}" FontSize="42" FontWeight="Light" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Classes="session-action" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                            <Button Grid.Column="1" Classes="session-action" Content="Stop" Command="{Binding StopCommand}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              <Border Classes="card" Padding="24,32" IsVisible="{Binding HasNoFocusSessions}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Ready when you are." FontSize="22" Foreground="{DynamicResource InkBrush}" />
                  <TextBlock Text="Start an activity, or start a task from your board. Your focus timer will live here." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Text="BACKGROUND" Classes="eyebrow" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding BackgroundSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="20" Margin="0,0,0,10">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Classes="tracker-label" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="tracker-state" Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding ElapsedLabel}" FontSize="28" Foreground="{Binding AccentColor}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                          <Button Classes="session-action" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                          <Button Grid.Column="1" Classes="session-action" Content="Stop" Command="{Binding StopCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nothing running alongside your focus." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoBackgroundSessions}" />
            </StackPanel>
            </ScrollViewer>
          </Grid>

        </StackPanel>

        <StackPanel Spacing="18" IsVisible="{Binding IsHistoryVisible}">
          <Grid x:Name="HistoryToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
            <StackPanel Spacing="5"><TextBlock Text="SESSION LOG" Classes="eyebrow" /><TextBlock Text="Last 30 days · most recent first" Classes="muted" FontSize="12" /></StackPanel>
            <Button x:Name="HistoryManualButton" Grid.Column="1" Classes="secondary" Content="+ Manual time" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="manual" />
          </Grid>
          <Border Classes="card" Padding="24,12">
            <StackPanel Spacing="4">
              <Grid Classes="desktop-table-heading" ColumnDefinitions="*,110,100,64" ColumnSpacing="12" Margin="0,12">
                <TextBlock Text="WORK / ACTIVITY" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="STARTED" Classes="eyebrow" /><TextBlock Grid.Column="2" Text="DURATION" Classes="eyebrow" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Classes="catalog-row" Padding="0,18">
                    <local:ReportRowGrid Classes="history-row" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                      <StackPanel Classes="history-title" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Context}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                      </StackPanel>
                      <StackPanel Classes="history-start" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding ShortDateLabel}" FontSize="12" /><TextBlock Text="{Binding StartLabel}" Classes="muted" FontSize="12" /></StackPanel>
                      <StackPanel Classes="history-duration" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Classes="mobile-metric-label muted" Text="Duration" FontSize="11" />
                        <TextBlock Text="{Binding DurationLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Classes="ghost history-edit" Content="Edit" AutomationProperties.Name="Correct time entry" Command="{Binding $parent[local:WorkspaceView].DataContext.OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                    </local:ReportRowGrid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="secondary" Content="Load more history" HorizontalAlignment="Left" Margin="0,16" IsVisible="{Binding HistoryHasMore}" Command="{Binding LoadMoreHistoryCommand}" />
              <StackPanel Spacing="12" Margin="0,32" IsVisible="{Binding HasNoHistory}">
                <TextBlock Text="Your work will leave a trail here." Classes="section-heading" TextWrapping="Wrap" />
                <TextBlock Text="Start a timer or add manual time. Sessions matching your search will appear here." Classes="muted" TextWrapping="Wrap" />
                <Button Classes="secondary" Content="Open time tracker →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="20" IsVisible="{Binding IsSummaryVisible}">
          <Border Classes="toolbar">
            <WrapPanel>
              <Button Classes="tab" Classes.selected="{Binding IsSummaryDay}" Content="Day" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Day" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryTask}" Content="Task" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Task" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryProject}" Content="Project" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Project" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryActivity}" Content="Activity" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Activity" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryActivityGroup}" Content="Activity group" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="ActivityGroup" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryTag}" Content="Tag" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Tag" />
              <Button Classes="tab" Classes.selected="{Binding IsSummaryLane}" Content="Lane" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Lane" />
            </WrapPanel>
          </Border>
          <Border Classes="card" Padding="24">
            <StackPanel Spacing="22">
              <Grid x:Name="SummaryHeading" ColumnDefinitions="*,120,120" ColumnSpacing="16">
                <StackPanel Spacing="5"><TextBlock Text="TIME BREAKDOWN" Classes="eyebrow" /><TextBlock Text="{Binding SummaryGroupingLabel}" Classes="section-heading" /></StackPanel>
                <TextBlock x:Name="SummaryAttributedHeading" Grid.Column="1" Text="Attributed time" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                <TextBlock x:Name="SummaryCoverageHeading" Grid.Column="2" Text="Clock coverage" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SummaryItems}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <local:ReportRowGrid IsSummary="True" Classes="summary-row" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="16" Margin="0,0,0,22">
                    <StackPanel Classes="summary-label" Spacing="10">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <ProgressBar Value="{Binding BarPercent}" Maximum="100" Height="6" MinHeight="6" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SubtleBrush}" AutomationProperties.Name="{Binding Label}" />
                    </StackPanel>
                    <StackPanel Classes="summary-attributed" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Classes="mobile-metric-label muted" Text="Attributed time" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DurationLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Classes="summary-coverage" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Classes="mobile-metric-label muted" Text="Clock coverage" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CoverageLabel}" Classes="muted" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                  </local:ReportRowGrid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="12" Margin="0,16" IsVisible="{Binding HasNoSummary}">
                <TextBlock Text="A little time makes a bigger picture." Classes="section-heading" TextWrapping="Wrap" />
                <TextBlock Text="Track your first session to see how your time adds up." Classes="muted" TextWrapping="Wrap" />
                <Button Classes="secondary" Content="Start tracking →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
              </StackPanel>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <TextBlock Text="Attributed time adds up every session. Clock coverage counts overlapping time once within each group. Bars compare attributed time with the largest group." Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsCalendarVisible}">
          <Border x:Name="CalendarCard" Classes="card">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Classes.selected="{Binding IsCalendarEventMode}" Content="Event" AutomationProperties.Name="Show calendar Event mode" Command="{Binding SelectCalendarModeCommand}" CommandParameter="Event" />
                <Button Classes="ghost" Classes.selected="{Binding IsCalendarHistoryMode}" Content="History" AutomationProperties.Name="Show calendar History mode" Command="{Binding SelectCalendarModeCommand}" CommandParameter="History" />
              </StackPanel>
              <Grid x:Name="CalendarRangeHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding CalendarRangeLabel}" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CalendarTimeZoneLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="CalendarRangeActions" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="ghost" Content="‹" AutomationProperties.Name="Previous calendar range" Command="{Binding NavigateCalendarCommand}" CommandParameter="previous" />
                  <Button Classes="ghost" Content="Today" AutomationProperties.Name="Calendar today" Command="{Binding NavigateCalendarCommand}" CommandParameter="today" />
                  <Button Classes="ghost" Content="›" AutomationProperties.Name="Next calendar range" Command="{Binding NavigateCalendarCommand}" CommandParameter="next" />
                </StackPanel>
              </Grid>
              <WrapPanel x:Name="CalendarViewChoices">
                  <Button Classes="ghost" IsVisible="{Binding IsCalendarEventMode}" Classes.selected="{Binding IsCalendarDay}" AutomationProperties.Name="Show calendar day" Content="Day" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Day" />
                  <Button Classes="ghost" Classes.selected="{Binding IsCalendarWeek}" AutomationProperties.Name="Show calendar week" Content="Week" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Week" />
                  <Button Classes="ghost" IsVisible="{Binding IsCalendarEventMode}" Classes.selected="{Binding IsCalendarMonth}" AutomationProperties.Name="Show calendar month" Content="Month" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Month" />
                  <Button Classes="ghost" IsVisible="{Binding IsCalendarHistoryMode}" Classes.selected="{Binding IsCalendarFlex}" AutomationProperties.Name="Show calendar flex" Content="Flex" ToolTip.Tip="Fits as many days as the window comfortably allows" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Flex" />
                <Button Classes="ghost" IsVisible="{Binding IsCalendarEventMode}" Classes.selected="{Binding IsCalendarAgenda}" AutomationProperties.Name="Show calendar agenda" Content="Agenda" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Agenda" />
              </WrapPanel>
              <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding HasSelectedCalendarItem}">
                <Grid x:Name="CalendarInspectorLayout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                  <StackPanel Spacing="5" DataContext="{Binding SelectedCalendarItem}">
                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IntervalLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Classes="primary" Content="Start planned work" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                  </StackPanel>
                  <StackPanel x:Name="CalendarInspectorActions" Grid.Column="1" Spacing="6">
                    <Button Classes="ghost" Content="Close" Command="{Binding CloseCalendarItemCommand}" />
                    <Button Classes="ghost" Content="Edit in agenda" IsVisible="{Binding CanEditCalendarItemInAgenda}" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Agenda" />
                  </StackPanel>
                </Grid>
              </Border>
              <WrapPanel IsVisible="{Binding IsCalendarEventMode}">
                <Button Classes="secondary" Content="+ Plan a task" AutomationProperties.Name="Open task planning" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="plan" />
                <Button Classes="ghost" Content="+ New event" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="event" />
              </WrapPanel>
              <StackPanel Spacing="4" IsVisible="{Binding IsCalendarHistoryMode}">
                <TextBlock Text="{Binding CalendarHistoryLegend}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CalendarHistoryNotice}" IsVisible="{Binding HasCalendarHistoryNotice}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <local:CalendarTimeline x:Name="CalendarTimeGrid" Days="{Binding CalendarDayColumns}" IsVisible="{Binding IsCalendarTimelineVisible}" />
              <local:CalendarMonthGrid x:Name="CalendarMonthGrid" Days="{Binding CalendarDayColumns}" IsVisible="{Binding IsCalendarMonth}" />
              <Border IsVisible="{Binding IsCalendarAgenda}">
              <StackPanel Spacing="10">
              <ItemsControl ItemsSource="{Binding CalendarBlocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="9">
                        <Border Background="{DynamicResource AccentSoftHoverBrush}" CornerRadius="8" Padding="9,7">
                          <TextBlock Text="◫" Foreground="{DynamicResource AccentBrush}" FontSize="16" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Classes="agenda-title" Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DayLabel}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <StackPanel Classes="agenda-time" Spacing="4">
                          <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                          <TextBlock Text="{Binding DurationLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Classes="agenda-actions" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="Edit plan" Command="{Binding $parent[local:WorkspaceView].DataContext.OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                          <Button Classes="secondary" Content="Start" Command="{Binding StartCommand}" />
                        </StackPanel>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="EVENTS" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding CalendarEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource PausedSurfaceBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LocationLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DescriptionLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <Button Classes="ghost" Content="Edit event" HorizontalAlignment="Left" Command="{Binding $parent[local:WorkspaceView].DataContext.OpenUtilityEditorCommand}" CommandParameter="{Binding}" />

                        <Button Classes="ghost" AutomationProperties.Name="Delete calendar event" Content="Delete event" HorizontalAlignment="Left" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No planned blocks in this range." Classes="muted" IsVisible="{Binding HasNoCalendarBlocks}" />
              </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <local:HabitsView x:DataType="local:MainWindowViewModel" x:CompileBindings="True" IsVisible="{Binding IsHabitsVisible}" />
        <local:JournalsView x:DataType="local:MainWindowViewModel" x:CompileBindings="True" IsVisible="{Binding IsJournalsVisible}" />
        <local:SettingsView IsVisible="{Binding IsSettingsVisible}" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">
        <Border Background="{DynamicResource PausedSurfaceBrush}" Padding="10" CornerRadius="8" IsVisible="{Binding ConnectionProblem}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Daemon connection interrupted. This view may be out of date. Your draft is kept; writes are not queued offline." TextWrapping="Wrap" Foreground="{DynamicResource PausedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Retry refresh" Classes="secondary" Command="{Binding RefreshCommand}" AutomationProperties.Name="Retry daemon refresh" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="ConnectionSettingsButton" Grid.Column="1" Content="Connection…" Classes="ghost" Click="OnConnectionSettings" AutomationProperties.Name="Connection settings" />
        </Grid>
      </StackPanel>
    </Grid>
    <Border x:Name="CompactNavigation" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4">
      <UniformGrid Columns="4">
        <Button Classes="ghost" Classes.selected="{Binding IsTodayVisible}" Content="Today" Command="{Binding SelectSectionCommand}" CommandParameter="Today" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Classes="ghost" Classes.selected="{Binding IsTasksVisible}" Content="Tasks" Command="{Binding SelectSectionCommand}" CommandParameter="Tasks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Classes="ghost" Classes.selected="{Binding IsTimeTrackerVisible}" Content="Timer" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button x:Name="MoreNavigation" Classes="ghost" Content="More" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
          <Button.Flyout>
            <Flyout Placement="Top">
              <StackPanel Spacing="4">
                <Button Content="Habits" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="Habits" MinHeight="48" />
                <Button Content="Journals" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="Journals" MinHeight="48" />
                <Button Content="Calendar" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="Calendar" MinHeight="48" />
                <Button Content="History" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="History" MinHeight="48" />
                <Button Content="Summary" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="Summary" MinHeight="48" />
                <Button Content="Settings" Click="OnCompactDestination" Command="{Binding SelectSectionCommand}" CommandParameter="Settings" MinHeight="48" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </UniformGrid>
    </Border>
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#4020263D" IsVisible="{Binding IsTaskEditorOpen}">
      <Border x:Name="TaskDrawer" Width="450" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" Padding="24" BoxShadow="-8 0 32 0 #2020263D" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="TASK DETAILS" Classes="eyebrow" />
              <TextBlock Text="Make the next step clear" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CloseTaskEditorCommand}" AutomationProperties.Name="Cancel task editing" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
              <StackPanel Spacing="12" DataContext="{Binding TaskEditor}">
                <StackPanel Spacing="5">
                  <TextBlock Text="Title" Classes="muted" FontSize="12" />
                  <TextBox x:Name="TaskEditorTitle" AutomationProperties.Name="Task editor title" Text="{Binding DraftTitle, Mode=TwoWay}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="5">
                  <TextBlock Text="Description" Classes="muted" FontSize="12" />
                  <TextBox AutomationProperties.Name="Task editor description" Text="{Binding DraftDescription, Mode=TwoWay}" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="What does done look like?" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="5"><TextBlock Text="Priority" Classes="muted" FontSize="12" /><ComboBox AutomationProperties.Name="Task editor priority" ItemsSource="{Binding PriorityOptions}" SelectedValue="{Binding DraftPriority, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Due date" Classes="muted" FontSize="12" /><TextBox AutomationProperties.Name="Task editor deadline" Text="{Binding DueDateText, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" /></StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="5"><TextBlock Text="Reminder time" Classes="muted" FontSize="12" /><TextBox AutomationProperties.Name="Task reminder time" Text="{Binding ReminderTimeText, Mode=TwoWay}" PlaceholderText="HH:mm · optional" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Time zone" Classes="muted" FontSize="12" /><TextBox AutomationProperties.Name="Task reminder time zone" Text="{Binding ReminderTimeZone, Mode=TwoWay}" /></StackPanel>
                </Grid>
                <StackPanel Spacing="5"><TextBlock Text="Repeated clock time" Classes="muted" FontSize="12" /><ComboBox AutomationProperties.Name="Task reminder repeated time choice" ItemsSource="{Binding ReminderFoldOptions}" SelectedValue="{Binding ReminderFoldChoice, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" /></StackPanel>
                <TextBlock Text="A time creates an inexact Android reminder in the chosen zone. Delivery can be delayed by Doze, notification settings, battery restrictions, force-stop, or an unreachable attached daemon. Leave time blank for a date-only deadline; leave both blank to clear." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Spacing="5"><TextBlock Text="Default activity" Classes="muted" FontSize="12" /><ComboBox ItemsSource="{Binding ActivityOptions}" SelectedValue="{Binding DraftActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose activity" /></StackPanel>
                <CheckBox Content="Star this task" IsChecked="{Binding DraftStarred, Mode=TwoWay}" />
                <Expander Header="Tags, dependencies &amp; references" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <TextBlock Text="These actions apply immediately." Classes="muted" FontSize="11" />
                    <TextBox Text="{Binding TagText, Mode=TwoWay}" PlaceholderText="Tag" />
                    <Button Classes="ghost" Content="Add tag" Command="{Binding AddTagCommand}" />
                    <ComboBox Classes="structured-picker" AutomationProperties.Name="Prerequisite task" ItemsSource="{Binding DependencyOptions}" SelectedValue="{Binding PrerequisiteTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" ItemTemplate="{StaticResource TaskPickerTemplate}" PlaceholderText="Prerequisite task" />
                    <Button Classes="ghost" Content="Add prerequisite" Command="{Binding AddDependencyCommand}" />
                    <TextBox Text="{Binding LinkLabelText, Mode=TwoWay}" PlaceholderText="Reference label" />
                    <TextBox Text="{Binding LinkUriText, Mode=TwoWay}" PlaceholderText="https:// or file://" />
                    <Button Classes="ghost" Content="Add reference" Command="{Binding AddLinkCommand}" />
                  </StackPanel>
                </Expander>
                <StackPanel Spacing="6">
                  <TextBlock Text="ARCHIVE &amp; RECOVERY" Classes="eyebrow" />
                  <TextBlock Text="Applies immediately. Restore from task filters." Classes="muted" FontSize="11" />
                  <WrapPanel Classes="editor">
                    <Button Classes="caution" Content="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}" AutomationProperties.Name="Archive or restore task" />
                    <Button Classes="danger" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete or restore task" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Text="Save title, description, priority, deadline, activity, and star." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <Button Classes="primary" Content="Save task" AutomationProperties.Name="Save task editor" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Expander Header="Move to another project" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding CurrentProjectPath}" AutomationProperties.Name="Current task location" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ComboBox Classes="structured-picker" AutomationProperties.Name="Move task to project" ItemsSource="{Binding MoveOptions}" SelectedValue="{Binding TargetProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" ItemTemplate="{StaticResource TaskPickerTemplate}" />
                    <Button Classes="secondary" Content="Move to project" Command="{Binding MoveCommand}" />
                    <TextBlock Text="Moves immediately. Cancel does not undo a move." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel DataContext="{Binding SelectedTaskDetails}" Spacing="8">
                <TextBlock Text="{Binding TrackedLabel}" Classes="muted" />
                <TextBlock Text="{Binding PrerequisiteLabel}" Classes="muted" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Classes="muted" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl ItemsSource="{Binding Links}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Uri}" Classes="muted" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Text="Cancel discards unsaved task fields. Immediate actions are kept." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#4020263D" IsVisible="{Binding IsUtilityEditorOpen}">
      <Border x:Name="UtilityDrawer" Background="{DynamicResource SurfaceBrush}" Width="480" HorizontalAlignment="Right" Padding="28" BoxShadow="-8 0 24 0 #1820263D" KeyboardNavigation.TabNavigation="Cycle">
        <local:UtilityEditorView />
      </Border>
    </Grid>
    <Canvas x:Name="BoardDragOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False">
      <Border x:Name="BoardDragPreview" Classes="task-card" Width="260" Padding="18" BoxShadow="0 12 28 0 #3320263D">
        <StackPanel Spacing="10">
          <TextBlock Text="MOVING TASK" Classes="eyebrow" Foreground="{DynamicResource RunningBrush}" />
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Drop on a project · Esc to cancel" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</UserControl>
