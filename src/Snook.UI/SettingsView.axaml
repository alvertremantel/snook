<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Snook.UI" x:Class="Snook.UI.SettingsView"
             xmlns:app="clr-namespace:Snook.Application;assembly=Snook.Application"
             x:DataType="local:MainWindowViewModel" x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="Border.catalog-row.deleted">
      <Setter Property="Background" Value="#F4EEEE" />
      <Setter Property="BorderBrush" Value="#AC7474" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.deleted TextBlock.record-name">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="#705757" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="22">
    <Border Classes="toolbar">
      <WrapPanel>
        <Button Classes="tab" Classes.selected="{Binding IsGeneralSettings}" Content="General &amp; data" Command="{Binding SelectSettingsPageCommand}" CommandParameter="General" />
        <Button Classes="tab" Classes.selected="{Binding IsOrganizationSettings}" Content="Boards &amp; projects" Command="{Binding SelectSettingsPageCommand}" CommandParameter="Organization" />
        <Button Classes="tab" Classes.selected="{Binding IsActivitySettings}" Content="Activities" Command="{Binding SelectSettingsPageCommand}" CommandParameter="Activities" />
        <Button Classes="tab" Classes.selected="{Binding IsCalendarSettings}" Content="Calendars" Command="{Binding SelectSettingsPageCommand}" CommandParameter="Calendars" />
      </WrapPanel>
    </Border>
    <StackPanel Spacing="20" IsVisible="{Binding IsGeneralSettings}">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="20">
          <StackPanel Spacing="6"><TextBlock Text="YOUR DATA" Classes="eyebrow" /><TextBlock Text="A workspace you can keep." Classes="section-heading" /><TextBlock Text="Create a verified copy, or take your work with you." Classes="muted" /></StackPanel>
          <Grid x:Name="DataActionsGrid" ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="18">
            <StackPanel x:Name="BackupActions" Spacing="10">
              <TextBlock Text="Back up &amp; recover" FontWeight="SemiBold" />
              <TextBlock Text="Save a checked copy of your workspace. Restore the latest backup when you need it." Classes="muted" TextWrapping="Wrap" />
              <Button Classes="primary" Content="Create backup" AutomationProperties.Name="Create verified backup" Command="{Binding BackupCommand}" />
              <Button Classes="ghost" Content="{Binding RestoreActionLabel}" AutomationProperties.Name="{Binding RestoreActionLabel}" Command="{Binding RestoreCommand}" />
            </StackPanel>
            <StackPanel x:Name="ExportActions" Grid.Column="1" Spacing="10">
              <TextBlock Text="Export your work" FontWeight="SemiBold" />
              <TextBlock Text="Keep a full JSON export, or use your last 30 days of time entries in a spreadsheet." Classes="muted" TextWrapping="Wrap" />
              <Button Classes="secondary" Content="Export workspace JSON" AutomationProperties.Name="Export workspace JSON" Command="{Binding ExportCommand}" />
              <Button Classes="ghost" Content="Export worklog CSV" AutomationProperties.Name="Export CSV worklog" Command="{Binding ExportCsvCommand}" />
              <Button Classes="secondary" Content="Share workspace JSON" AutomationProperties.Name="Share workspace JSON" Command="{Binding ShareExportCommand}" IsVisible="{Binding HasDocumentShare}" />
              <Button Classes="ghost" Content="Share worklog CSV" AutomationProperties.Name="Share CSV worklog" Command="{Binding ShareCsvCommand}" IsVisible="{Binding HasDocumentShare}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding IsDaemonHostAdministrator}">
        <StackPanel Spacing="12">
          <TextBlock Text="TAILNET DEVICES" Classes="eyebrow" />
          <TextBlock Text="Pair a tailnet device" Classes="section-heading" AutomationProperties.Name="Tailnet device administration" />
          <TextBlock Text="The daemon stays on loopback. Tailscale Serve supplies tailnet-only HTTPS; Snook keeps separate revocable credentials. Funnel is public and unsupported." Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="5">
              <TextBlock Text="Device name" FontWeight="SemiBold" />
              <TextBox Text="{Binding PairDeviceName}" AutomationProperties.Name="Pairing device name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Tailscale login · optional" FontWeight="SemiBold" />
              <TextBox Text="{Binding PairIntendedLogin}" AutomationProperties.Name="Intended Tailscale login" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="5">
            <TextBlock Text="Tailscale Serve URL" FontWeight="SemiBold" />
            <TextBox Text="{Binding PairServeOrigin}" PlaceholderText="https://snook-host.example-tailnet.ts.net/" AutomationProperties.Name="Pairing Serve URL" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="Create single-use invitation" Command="{Binding CreatePairingInvitationCommand}" AutomationProperties.Name="Create tailnet pairing invitation" />
            <Button Classes="ghost" Content="Cancel invitation" Command="{Binding CancelPairingInvitationCommand}" IsVisible="{Binding HasPairingInvitation}" AutomationProperties.Name="Cancel tailnet pairing invitation" />
          </StackPanel>
          <TextBox Text="{Binding PairingInvitationText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="72" PlaceholderText="The Serve URL, code, and expiration appear here." AutomationProperties.Name="Pairing invitation payload" />
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Paired credentials" FontWeight="SemiBold" /><Button Grid.Column="1" Classes="ghost" Content="Refresh" Command="{Binding RefreshPairedDevicesCommand}" /></Grid>
          <ItemsControl ItemsSource="{Binding PairedDevices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:PairedDeviceInfo">
            <Border Classes="catalog-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><StackPanel Spacing="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding CredentialId}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding TailscaleLogin}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding CreatedAtUtc, StringFormat='Created {0:u}'}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding PendingUntilUtc, StringFormat='Awaiting client confirmation until {0:u}'}" Classes="muted" FontSize="11" AutomationProperties.Name="Provisional credential expiry" /><TextBlock Text="{Binding LastSeenAtUtc, StringFormat='Last seen {0:u}'}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding Revoked, StringFormat='Revoked: {0}'}" Classes="muted" FontSize="11" /></StackPanel><Button Grid.Column="1" Classes="ghost" Content="Revoke" IsEnabled="{Binding !Revoked}" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).RevokePairedDeviceCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Revoke paired device" /></Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="FOCUS TIMERS" Classes="eyebrow" />
          <TextBlock Text="One thing at a time, or a few." Classes="section-heading" />
          <TextBlock Text="By default, starting a focus timer pauses the previous one. Background activities can keep running alongside it." Classes="muted" TextWrapping="Wrap" />
          <CheckBox Content="Allow more than one focus timer to run" IsChecked="{Binding AllowConcurrentForeground}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Save timer preference" Command="{Binding SaveSettingsCommand}" />
            <Button Classes="ghost" Content="Reset to saved" Command="{Binding ResetTimerPreferenceCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding HasTimerNotificationSetup}">
        <StackPanel Spacing="12">
          <TextBlock Text="TIMER NOTIFICATIONS" Classes="eyebrow" />
          <TextBlock Text="Keep active time visible." Classes="section-heading" />
          <TextBlock Text="Allow Snook to show running and paused timers with Pause, Resume, and Stop actions. Timer truth stays in the workspace; denial does not affect timers inside the app. Task and activity details are hidden on the lock screen." Classes="muted" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary" Content="Enable timer notifications" AutomationProperties.Name="Enable timer notifications" Command="{Binding TimerNotificationSetupCommand}" />
            <Button Classes="ghost" Margin="8,0,0,0" Content="Review Live Update access" AutomationProperties.Name="Review Live Update access" Command="{Binding TimerLiveUpdateSetupCommand}" IsVisible="{Binding HasTimerLiveUpdateSetup}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding HasReminderNotificationSetup}">
        <StackPanel Spacing="12">
          <TextBlock Text="TASK REMINDERS" Classes="eyebrow" />
          <TextBlock Text="Timed deadlines, without false promises." Classes="section-heading" />
          <TextBlock Text="Allow Snook to schedule inexact notifications for tasks with an explicit date, time, and zone. Android can delay delivery under Doze, battery restrictions, force-stop, or permission changes. Attached reminders use a bounded encrypted last-synced index and say when the daemon could not be reached." Classes="muted" TextWrapping="Wrap" />
          <Button Classes="secondary" Content="Enable and test reminders" AutomationProperties.Name="Enable and test task reminders" Command="{Binding ReminderNotificationSetupCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding HasAppLockSetup}">
        <StackPanel Spacing="12">
          <TextBlock Text="APP LOCK" Classes="eyebrow" />
          <TextBlock Text="Hide the workspace when you step away." Classes="section-heading" />
          <TextBlock Text="Enable or disable an optional foreground gate backed by Android's enrolled device credential. Snook hides its activity before authentication; this does not encrypt the SQLite workspace or replace full-device encryption." Classes="muted" TextWrapping="Wrap" />
          <Button Classes="secondary" Content="Change app lock" AutomationProperties.Name="Change Android app lock" Command="{Binding AppLockSetupCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding HasNotificationPrivacySetup}">
        <StackPanel Spacing="12">
          <TextBlock Text="NOTIFICATION PRIVACY" Classes="eyebrow" />
          <TextBlock Text="Choose whether private titles leave the app." Classes="section-heading" />
          <TextBlock Text="Details are hidden by default. Toggle private notification details to allow task and activity titles in the notification shade. Public lock-screen versions stay redacted, and descriptions or journal text are never included." Classes="muted" TextWrapping="Wrap" />
          <Button Classes="secondary" Content="Toggle private notification details" AutomationProperties.Name="Toggle private notification details" Command="{Binding NotificationPrivacySetupCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24" IsVisible="{Binding HasScreenPrivacySetup}">
        <StackPanel Spacing="12">
          <TextBlock Text="SCREEN PRIVACY" Classes="eyebrow" />
          <TextBlock Text="Control screenshots and recent-task previews." Classes="section-heading" />
          <TextBlock Text="Toggle capture blocking for the ordinary workspace. Locked screens are always protected. Leaving screenshots available can help accessibility and support workflows; enable blocking when shoulder-surfing or recent-task previews are the greater risk." Classes="muted" TextWrapping="Wrap" />
          <Button Classes="secondary" Content="Toggle workspace capture blocking" AutomationProperties.Name="Toggle workspace screenshot blocking" Command="{Binding ScreenPrivacySetupCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="20" IsVisible="{Binding IsOrganizationSettings}">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="5"><TextBlock Text="BOARDS" Classes="eyebrow" /><TextBlock Text="The bigger picture" Classes="section-heading" /><TextBlock Text="Boards hold the projects that belong together." Classes="muted" /></StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewBoardName}" PlaceholderText="New board name" AutomationProperties.Name="New board name" /><Button Grid.Column="1" Classes="secondary" Content="Add board" Command="{Binding CreateBoardCommand}" /></Grid>
          <CheckBox Content="Show deleted boards" IsChecked="{Binding ShowDeletedBoards, Mode=TwoWay}" />
          <ItemsControl ItemsSource="{Binding VisibleBoardAdminRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BoardAdminRowViewModel">
              <Border Classes="catalog-row" Classes.deleted="{Binding IsDeleted}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Classes="record-name" Text="{Binding Board.Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LifecycleLabel}" Classes="muted" FontSize="12" /></StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit board" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="ghost" Content="•••" AutomationProperties.Name="Board actions">
                    <Button.Flyout><Flyout><StackPanel Spacing="4" MinWidth="180">
                      <Button Classes="ghost" Content="Move earlier" Command="{Binding MoveEarlierCommand}" /><Button Classes="ghost" Content="Move later" Command="{Binding MoveLaterCommand}" />
                      <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" /><Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </StackPanel></Flyout></Button.Flyout>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="5"><TextBlock Text="PROJECTS" Classes="eyebrow" /><TextBlock Text="A place for each next step" Classes="section-heading" /></StackPanel>
          <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Boards}" SelectedValue="{Binding SelectedBoardId}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="New project board" />
            <TextBox Grid.Column="1" Text="{Binding NewProjectName}" PlaceholderText="New project name" AutomationProperties.Name="New project name" /><Button Grid.Column="2" Classes="secondary" Content="Add project" Command="{Binding CreateProjectCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ProjectAdminRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ProjectAdminRowViewModel">
              <Border Classes="catalog-row"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LifecycleLabel}" Classes="muted" FontSize="12" /></StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit project" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="2" Classes="ghost" Content="•••" AutomationProperties.Name="Project actions"><Button.Flyout><Flyout><StackPanel Spacing="6" Width="220">
                  <Button Classes="ghost" Content="Move earlier" Command="{Binding MoveEarlierCommand}" /><Button Classes="ghost" Content="Move later" Command="{Binding MoveLaterCommand}" /><Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" /><Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                </StackPanel></Flyout></Button.Flyout></Button>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="20" IsVisible="{Binding IsActivitySettings}">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="5"><TextBlock Text="ACTIVITY LIBRARY" Classes="eyebrow" /><TextBlock Text="The things you spend time on" Classes="section-heading" /></StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="+ New activity" Command="{Binding OpenUtilityEditorCommand}" CommandParameter="activity" />
          </Grid>
          <TextBlock Text="Start activities in Time Tracker. Organize and maintain them here." Classes="muted" TextWrapping="Wrap" />
          <CheckBox Content="Show deleted activities" IsChecked="{Binding ShowDeletedActivities, Mode=TwoWay}" />
          <ItemsControl ItemsSource="{Binding VisibleActivityAdminRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActivityAdminRowViewModel">
              <Border Classes="catalog-row" Classes.deleted="{Binding IsDeleted}"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Classes="record-name" Text="{Binding Activity.Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CatalogLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit activity" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="2" Classes="ghost" Content="•••" AutomationProperties.Name="Activity actions"><Button.Flyout><Flyout><StackPanel Spacing="6" Width="220">
                  <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" /><Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                </StackPanel></Flyout></Button.Flyout></Button>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No activities to show. Create one or show deleted activities to restore one." Classes="muted" IsVisible="{Binding HasNoActivities}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="ACTIVITY GROUPS" Classes="eyebrow" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewActivityGroupName}" PlaceholderText="New group name" AutomationProperties.Name="New activity group name" /><Button Grid.Column="1" Classes="secondary" Content="Add group" Command="{Binding CreateActivityGroupCommand}" /></Grid>
          <ItemsControl ItemsSource="{Binding ActivityGroupAdminRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActivityGroupAdminRowViewModel">
              <Border Classes="catalog-row"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Group.Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LifecycleLabel}" Classes="muted" FontSize="12" /></StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit activity group" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="2" Classes="ghost" Content="•••" AutomationProperties.Name="Group actions"><Button.Flyout><Flyout><StackPanel Spacing="4" MinWidth="180"><Button Classes="ghost" Content="Move earlier" Command="{Binding MoveEarlierCommand}" /><Button Classes="ghost" Content="Move later" Command="{Binding MoveLaterCommand}" /><Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" /></StackPanel></Flyout></Button.Flyout></Button>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="20" IsVisible="{Binding IsCalendarSettings}">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="5"><TextBlock Text="CALENDARS" Classes="eyebrow" /><TextBlock Text="Give your plans a home" Classes="section-heading" /><TextBlock Text="Choose which calendars appear in your schedule." Classes="muted" /></StackPanel>
          <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewCalendarName}" PlaceholderText="New calendar name" AutomationProperties.Name="New calendar name" /><TextBox Grid.Column="1" Text="{Binding NewCalendarColor}" AutomationProperties.Name="New calendar color" /><Button Grid.Column="2" Classes="secondary" Content="Add calendar" Command="{Binding CreateCalendarCommand}" /></Grid>
          <ItemsControl ItemsSource="{Binding CalendarAdminRows}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CalendarAdminRowViewModel">
              <Border Classes="catalog-row"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Background="{Binding Calendar.Color}" Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Calendar.Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CatalogLabel}" Classes="muted" FontSize="12" /></StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="Edit" AutomationProperties.Name="Edit calendar" Command="{Binding $parent[local:SettingsView].((local:MainWindowViewModel)DataContext).OpenUtilityEditorCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="3" Classes="ghost" Content="•••" AutomationProperties.Name="Calendar actions"><Button.Flyout><Flyout><Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" /></Flyout></Button.Flyout></Button>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding HasDeletedCalendarEvents}">
        <StackPanel Spacing="16"><TextBlock Text="DELETED EVENTS" Classes="eyebrow" /><TextBlock Text="Bring an event back to its calendar." Classes="muted" />
          <ItemsControl ItemsSource="{Binding DeletedCalendarEvents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DeletedCalendarEventRowViewModel">
            <Border Classes="catalog-row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding DetailLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Restore" Command="{Binding RestoreCommand}" /></Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
