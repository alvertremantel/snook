<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Snook.UI.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F7F8FA" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172033" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7D899E" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#758096" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#DDE1EA" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BorderBrush" Value="#E7EAF0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B5BEF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#58657B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8D99AD" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#252B46" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="#F1F2FF" />
      <Setter Property="Foreground" Value="#5B5BEF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="#EAEAFF" />
      <Setter Property="Foreground" Value="#4949CB" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#353553" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="BorderBrush" Value="#E7EAF0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="WrapPanel.editor > Control">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </Application.Styles>
</Application>
