<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snook.UI"
        x:Class="Snook.UI.MainWindow"
        x:CompileBindings="False"
        Title="Snook"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640">
  <Grid ColumnDefinitions="196,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="16,26">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34">
              <TextBlock Text="S" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="snook" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="A quiet place for doing" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12" Margin="2,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="2">
          <TextBlock Text="WORKSPACE" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" Margin="14,0,0,10" />
          <Button Classes="nav" Classes.selected="{Binding IsTodayVisible}" AutomationProperties.Name="Today" Content="⌂   Today" Command="{Binding SelectSectionCommand}" CommandParameter="Today" />
          <Button Classes="nav" Classes.selected="{Binding IsTasksVisible}" AutomationProperties.Name="Tasks" Content="▣   Tasks" Command="{Binding SelectSectionCommand}" CommandParameter="Tasks" />
          <Button Classes="nav" Classes.selected="{Binding IsTimeTrackerVisible}" AutomationProperties.Name="Time Tracker" Content="◷   Time Tracker" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
          <Button Classes="nav" Classes.selected="{Binding IsCalendarVisible}" AutomationProperties.Name="Calendar" Content="□   Calendar" Command="{Binding SelectSectionCommand}" CommandParameter="Calendar" />
          <Button Classes="nav" Classes.selected="{Binding IsHistoryVisible}" AutomationProperties.Name="History" Content="▤   History" Command="{Binding SelectSectionCommand}" CommandParameter="History" />
          <Button Classes="nav" Classes.selected="{Binding IsSummaryVisible}" AutomationProperties.Name="Summary" Content="⌁   Summary" Command="{Binding SelectSectionCommand}" CommandParameter="Summary" />
          <TextBlock Text="MANAGE" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" Margin="14,12,0,8" />
          <Button Classes="nav" Classes.selected="{Binding IsSettingsVisible}" AutomationProperties.Name="Settings" Content="⚙   Settings" Command="{Binding SelectSectionCommand}" CommandParameter="Settings" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SidebarRaisedBrush}" CornerRadius="12" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding WorkspaceName}" Classes="eyebrow" Foreground="{DynamicResource SidebarMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding PrimarySession.Label}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="{Binding PrimarySession.ElapsedLabel}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="23" FontWeight="Light" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="{Binding PrimarySession.StateLabel}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" IsVisible="{Binding !HasNoFocusSessions}" />
            <TextBlock Text="No focus timer running" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNoFocusSessions}" />
            <Button Classes="ghost sidebar-action" Content="Open tracker →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,28,28,16">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="7">
          <TextBlock Text="{Binding CurrentSection}" Classes="eyebrow" />
          <TextBlock Text="{Binding SectionTitle}" Classes="title" />
          <TextBlock Text="{Binding SectionSubtitle}" Classes="muted" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" IsVisible="{Binding HasPageSearch}">
            <TextBox AutomationProperties.Name="{Binding SearchHint}" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding SearchHint}" BorderThickness="0" Background="Transparent" Width="190" />
          </Border>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22">
        <StackPanel Spacing="22" IsVisible="{Binding IsTodayVisible}">
          <TextBlock Text="{Binding TodayOverview}" Classes="muted" FontSize="12" />

          <Border Classes="card" Background="{DynamicResource PausedSurfaceBrush}" IsVisible="{Binding HasRecoverySessions}">
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="RECOVERY NEEDED" Classes="eyebrow" Foreground="{DynamicResource PausedBrush}" />
                <TextBlock Text="A timer boundary needs your decision." Foreground="{DynamicResource PausedBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Snook did not invent uncertain time. Choose how to resolve each item." Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding RecoverySessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource PausedSurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,2,0,0">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding ReasonLabel}" Foreground="{DynamicResource PausedBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="Session identity and previous intervals are preserved." Foreground="{DynamicResource PausedBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="ghost" Content="Last known" Command="{Binding StopAtLastKnownCommand}" />
                          <Button Classes="ghost" Content="Stop now" Command="{Binding StopNowCommand}" />
                          <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,1.15*" ColumnSpacing="22">
            <Border Grid.Column="0" Classes="card" Padding="0">
              <StackPanel>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="15,15,0,0" Padding="20">
                <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="QUICK CAPTURE" Classes="eyebrow" />
                    <TextBlock Text="Put it somewhere useful." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </StackPanel>

                </Grid>
                <TextBox AutomationProperties.Name="New task title" Text="{Binding TaskTitle, Mode=TwoWay}" PlaceholderText="What needs doing?" CornerRadius="9" Padding="12" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ComboBox AutomationProperties.Name="Task project" ItemsSource="{Binding Projects}" SelectedValue="{Binding SelectedProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose a project" Padding="10" />
                  <Button Grid.Column="1" Classes="primary" AutomationProperties.Name="Add task" Content="Add task" Command="{Binding CreateTaskCommand}" />
                </Grid>
                <TextBlock Text="Capture a thought now. Add the details when you’re ready." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                </Border>
                <StackPanel Spacing="14" Margin="20">
                <TextBlock Text="ON THE HORIZON" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayAgendaPreview}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2,0,0,0" Padding="12,4" Margin="0,4">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No upcoming plans. Leave some room, or add a block in Calendar." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoTodayUpcomingRows}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="CURRENTLY TRACKING" Classes="eyebrow" />
                  <TextBlock Text="Your focus, right now." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox AutomationProperties.Name="Dashboard activity" ItemsSource="{Binding Activities}" SelectedValue="{Binding SelectedTrackingActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose activity" />
                  <Button Grid.Column="1" Classes="primary" AutomationProperties.Name="Start or switch activity" Content="Start / switch" Command="{Binding StartSelectedActivityCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding SessionCountLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="All timers →" Command="{Binding SelectSectionCommand}" CommandParameter="Time Tracker" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TodayFocusSessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding LaneLabel}" />  ·  <Run Text="{Binding StateLabel}" /></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedLabel}" FontFamily="monospace" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Classes="ghost" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                            <Button Classes="icon" Content="■" Command="{Binding StopCommand}" ToolTip.Tip="Stop" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="12" IsVisible="{Binding HasNoFocusSessions}">
                  <TextBlock Text="Ready when you are. Choose an activity above, or start a task below." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="YOUR NEXT TASKS" Classes="eyebrow" />
                  <TextBlock Text="Choose one thing to move forward." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="View all  →" Command="{Binding SelectSectionCommand}" CommandParameter="Tasks" />
              </Grid>
              <ItemsControl ItemsSource="{Binding TodayNextTasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Width="22" Height="22" VerticalAlignment="Center">
                          <TextBlock Text="○" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding ProjectName}" />  ·  <Run Text="{Binding DueLabel}" /></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding PriorityLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                          <Button Classes="ghost" Content="Start" Command="{Binding StartCommand}" />
                          <Button Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding CompleteCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nothing queued here. Capture a next step, or open your task board." Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasNoTodayNextTasks}" />
            </StackPanel>
          </Border>
            </StackPanel>
          </Grid>


          <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="RECENTLY TRACKED" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayRecentRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No recent tracked work." Classes="muted" IsVisible="{Binding HasNoTodayRecentRows}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="UP NEXT" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding TodayUpcomingRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No upcoming deadlines or schedule." Classes="muted" IsVisible="{Binding HasNoTodayUpcomingRows}" />
              </StackPanel>
            </Border>
          </Grid>
                <Expander Header="Add manual time" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <TextBlock Text="MANUAL ENTRY" Classes="eyebrow" />
                    <Button Classes="ghost" AutomationProperties.Name="Add thirty minutes of manual time" Content="Quick entry: add the last 30 minutes" Command="{Binding QuickManualTimeCommand}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <ComboBox AutomationProperties.Name="Manual time task" ItemsSource="{Binding ManualTaskOptions}" SelectedValue="{Binding ManualTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Task (optional)" />
                      <ComboBox Grid.Column="1" AutomationProperties.Name="Manual time activity" ItemsSource="{Binding Activities}" SelectedValue="{Binding ManualActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Activity (optional)" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <TextBox AutomationProperties.Name="Manual time start" Text="{Binding ManualStartText, Mode=TwoWay}" PlaceholderText="Start (local, YYYY-MM-DD HH:MM)" />
                      <TextBox Grid.Column="1" AutomationProperties.Name="Manual time end" Text="{Binding ManualEndText, Mode=TwoWay}" PlaceholderText="End (local, YYYY-MM-DD HH:MM)" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox AutomationProperties.Name="Manual time notes" Text="{Binding ManualNotes, Mode=TwoWay}" PlaceholderText="Notes (optional)" />
                      <Button Grid.Column="1" Classes="primary" Content="Save manual time" Command="{Binding ManualTimeCommand}" />
                    </Grid>
                  </StackPanel>
                </Expander>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsTasksVisible}">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="12">
                <WrapPanel Classes="editor" Orientation="Horizontal">
                  <Button x:Name="TaskListViewButton" Classes="ghost" Classes.selected="{Binding IsTaskListVisible}" AutomationProperties.Name="Show tasks as list" Content="List" Command="{Binding SelectTaskViewCommand}" CommandParameter="List" />
                  <Button Classes="ghost" Classes.selected="{Binding IsTaskBoardVisible}" AutomationProperties.Name="Show tasks as board" Content="Board" Command="{Binding SelectTaskViewCommand}" CommandParameter="Board" />
                  <ComboBox ItemsSource="{Binding TaskSortOptions}" SelectedValue="{Binding TaskSortMode, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" Width="130" PlaceholderText="Sort" />
                  <CheckBox Content="Show completed" IsChecked="{Binding ShowCompleted, Mode=TwoWay}" />
                  <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
                  <CheckBox Content="Show deleted" IsChecked="{Binding ShowDeleted, Mode=TwoWay}" />
                </WrapPanel>
               </StackPanel>
               <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="12">
                 <StackPanel Spacing="12">

                   <Grid ColumnDefinitions="*,240,Auto" ColumnSpacing="8">
                     <TextBox AutomationProperties.Name="Tasks screen new task title" Text="{Binding TaskTitle, Mode=TwoWay}" PlaceholderText="What needs doing?" Padding="9" />
                     <ComboBox Grid.Column="1" AutomationProperties.Name="Tasks screen task project" ItemsSource="{Binding Projects}" SelectedValue="{Binding SelectedProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Project" Padding="9" />
                     <Button Grid.Column="2" Classes="primary" AutomationProperties.Name="Create task from Tasks" Content="Add task" Command="{Binding CreateTaskCommand}" />
                   </Grid>
                 </StackPanel>
               </Border>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <ComboBox x:Name="BoardProjectJump" IsVisible="{Binding IsTaskBoardVisible}" ItemsSource="{Binding TaskGroups}" DisplayMemberBinding="{Binding ProjectName}" PlaceholderText="Jump to a project" SelectionChanged="OnBoardProjectSelected" AutomationProperties.Name="Jump to board project" MaxWidth="280" HorizontalAlignment="Left" />
                <Button Grid.Column="1" IsVisible="{Binding IsTaskBoardVisible}" Classes="ghost" Content="←" Click="OnBoardPrevious" AutomationProperties.Name="Previous project lanes" />
                <Button Grid.Column="2" IsVisible="{Binding IsTaskBoardVisible}" Classes="ghost" Content="→" Click="OnBoardNext" AutomationProperties.Name="Next project lanes" />
                <Button x:Name="BoardCreationButton" Grid.Column="3" Classes="icon" Content="+ New board / project" AutomationProperties.Name="New board or project">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" Opened="OnBoardCreationOpened">
                      <StackPanel Width="340" Spacing="16" KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel Spacing="8">
                          <TextBlock Text="NEW BOARD" Classes="eyebrow" />
                          <TextBox AutomationProperties.Name="Tasks screen new board name" Text="{Binding NewBoardName, Mode=TwoWay}" PlaceholderText="Board name" />
                          <Button Classes="primary" AutomationProperties.Name="Create board from Tasks" Content="Add board" Command="{Binding CreateBoardCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Spacing="8">
                          <TextBlock Text="NEW PROJECT" Classes="eyebrow" />
                          <ComboBox AutomationProperties.Name="Tasks screen project board" ItemsSource="{Binding Boards}" SelectedValue="{Binding SelectedBoardId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose board" />
                          <TextBox AutomationProperties.Name="Tasks screen new project name" Text="{Binding NewProjectName, Mode=TwoWay}" PlaceholderText="Project name" />
                          <Button Classes="primary" AutomationProperties.Name="Create project from Tasks" Content="Add project" Command="{Binding CreateProjectCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="340" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Tasks}" IsVisible="{Binding IsTaskListVisible}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Width="22" Height="22" VerticalAlignment="Center">
                          <TextBlock Text="○" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding ProjectName}" />  ·  <Run Text="{Binding DueLabel}" />  ·  <Run Text="{Binding TrackedLabel}" /></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding PriorityLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                          <Button Classes="ghost" Content="Start" Command="{Binding StartCommand}" />
                          <Button Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding CompleteCommand}" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="ghost" Content="Edit &amp; details" Command="{Binding ShowDetailsCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTaskBoardVisible}">
              <ItemsControl ItemsSource="{Binding TaskGroups}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="project-lane" CornerRadius="11" Padding="12" Width="292" MinHeight="330" Margin="0,0,14,12">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                          <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="muted" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="task-card" Padding="14" Margin="0,0,0,12">
                              <StackPanel Spacing="12">
                                <Border Classes="drag-handle" Background="Transparent" Cursor="Hand" PointerPressed="OnCardPressed" PointerMoved="OnCardMoved" PointerReleased="OnCardReleased" PointerCaptureLost="OnCardCaptureLost" ToolTip.Tip="Drag to another project. You can also use Move below.">
                                <StackPanel Spacing="8">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding PriorityLabel}" Classes="eyebrow" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="⠿" Classes="muted" />
                                  </Grid>
                                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding DueLabel}" />  ·  <Run Text="{Binding TrackedLabel}" /></TextBlock>
                                </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto">
                                  <Button Classes="icon" Content="Start" Command="{Binding StartCommand}" />
                                  <Button Grid.Column="1" Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding CompleteCommand}" />
                                </Grid>
                                <Button Classes="ghost" Content="Edit &amp; details" Command="{Binding ShowDetailsCommand}" />
                              </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Drop a task here" Classes="muted" HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsEmpty}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="No tasks match this view." Classes="muted" IsVisible="{Binding HasNoTasks}" />

            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsTimeTrackerVisible}">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <ScrollViewer x:Name="TrackerActivitiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ACTIVITIES" Classes="eyebrow" />
                <TextBlock Text="Choose where your time goes" Classes="muted" FontSize="12" Grid.Column="1" />
              </Grid>
              <ItemsControl ItemsSource="{Binding TrackerGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Padding="16" Margin="0,0,0,14">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource InkBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Activities}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="activity" Classes.selected="{Binding IsRunning}" Command="{Binding StartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,3" ToolTip.Tip="{Binding Description}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LaneLabel}" Classes="muted" FontSize="11" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No available activities. Add one below, or restore one in Manage activities." TextWrapping="Wrap" Classes="muted" IsVisible="{Binding HasNoTrackerActivities}" />
            </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="TrackerSessionsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="IN PROGRESS" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="{Binding SessionCountLabel}" Classes="muted" FontSize="12" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FocusSessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="22,18" Margin="0,0,0,12">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontSize="12" />
                          </Grid>
                          <TextBlock Text="{Binding ElapsedLabel}" Foreground="{Binding AccentColor}" FontSize="42" FontWeight="Light" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Classes="session-action" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                            <Button Grid.Column="1" Classes="session-action" Content="Stop" Command="{Binding StopCommand}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              <Border Classes="card" Padding="24,32" IsVisible="{Binding HasNoFocusSessions}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Ready when you are." FontSize="22" Foreground="{DynamicResource InkBrush}" />
                  <TextBlock Text="Start an activity, or start a task from your board. Your focus timer will live here." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Text="BACKGROUND" Classes="eyebrow" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding BackgroundSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding SurfaceColor}" BorderBrush="{Binding AccentColor}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="20" Margin="0,0,0,10">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{Binding AccentColor}" FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding ElapsedLabel}" FontSize="28" Foreground="{Binding AccentColor}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                          <Button Classes="session-action" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                          <Button Grid.Column="1" Classes="session-action" Content="Stop" Command="{Binding StopCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nothing running alongside your focus." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoBackgroundSessions}" />
            </StackPanel>
            </ScrollViewer>
          </Grid>

          <Expander Header="Add time you already worked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="MANUAL TIME" Classes="eyebrow" />
                  <TextBlock Text="Record work that already happened." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <ComboBox AutomationProperties.Name="Tracker manual task" ItemsSource="{Binding ManualTaskOptions}" SelectedValue="{Binding ManualTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Task (optional)" />
                <ComboBox AutomationProperties.Name="Tracker manual activity" ItemsSource="{Binding Activities}" SelectedValue="{Binding ManualActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Activity (optional)" />
                <TextBox AutomationProperties.Name="Tracker manual start" Text="{Binding ManualStartText, Mode=TwoWay}" PlaceholderText="Start (local, YYYY-MM-DD HH:MM)" />
                <TextBox AutomationProperties.Name="Tracker manual end" Text="{Binding ManualEndText, Mode=TwoWay}" PlaceholderText="End (local, YYYY-MM-DD HH:MM)" />
                <TextBox AutomationProperties.Name="Tracker manual notes" Text="{Binding ManualNotes, Mode=TwoWay}" PlaceholderText="Notes (optional)" />
                <Button Classes="primary" Content="Save manual time" HorizontalAlignment="Left" Command="{Binding ManualTimeCommand}" />
              </StackPanel>
            </Border>
          </Expander>

          <Expander Header="New activity or group" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="NEW ACTIVITY" Classes="eyebrow" />
                <TextBlock Text="Track routines and work that do not need a task." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*,120,140,Auto" ColumnSpacing="8">
                <TextBox AutomationProperties.Name="New standalone activity name" Text="{Binding NewActivityName, Mode=TwoWay}" PlaceholderText="Activity name" />
                <TextBox Grid.Column="1" AutomationProperties.Name="New standalone activity description" Text="{Binding NewActivityDescription, Mode=TwoWay}" PlaceholderText="Description (optional)" />
                <ComboBox Grid.Column="2" AutomationProperties.Name="New activity lane" ItemsSource="{Binding SessionLaneOptions}" SelectedValue="{Binding NewActivityLane, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" />
                <ComboBox Grid.Column="3" AutomationProperties.Name="New activity group" ItemsSource="{Binding ActivityGroups}" SelectedValue="{Binding NewActivityGroupId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Group (optional)" />
                <Button Grid.Column="4" Classes="primary" AutomationProperties.Name="Create standalone activity" Content="Add activity" Command="{Binding CreateActivityCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox AutomationProperties.Name="New tracker activity group" Text="{Binding NewActivityGroupName, Mode=TwoWay}" PlaceholderText="New activity group" />
                <Button Grid.Column="1" Classes="ghost" Content="Add group" Command="{Binding CreateActivityGroupCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          </Expander>

          <Expander Header="Manage activities" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="ACTIVITIES" Classes="eyebrow" />
                <TextBlock Text="Start, organize, and maintain every trackable activity." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ActivityAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="8">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DraftName}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ActivityContextLabel}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Content="Start" Command="{Binding StartCommand}" />
                        <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="Manage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <WrapPanel Classes="editor" Orientation="Horizontal" MaxWidth="850">
                            <StackPanel Spacing="5"><TextBlock Text="Name" Classes="muted" FontSize="11" /><TextBox Text="{Binding DraftName, Mode=TwoWay}" Width="220" /></StackPanel>
                            <StackPanel Spacing="5"><TextBlock Text="Description" Classes="muted" FontSize="11" /><TextBox Text="{Binding DraftDescription, Mode=TwoWay}" Width="280" /></StackPanel>
                            <StackPanel Spacing="5"><TextBlock Text="Lane" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding LaneOptions}" SelectedValue="{Binding DraftLane, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" Width="150" /></StackPanel>
                            <StackPanel Spacing="5"><TextBlock Text="Group" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding GroupOptions}" SelectedValue="{Binding GroupId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="No group" Width="180" /></StackPanel>
                            <Button Classes="ghost" Content="Save" Command="{Binding SaveCommand}" VerticalAlignment="Bottom" />
                            <StackPanel Spacing="5"><TextBlock Text="Tag" Classes="muted" FontSize="11" /><TextBox Text="{Binding TagText, Mode=TwoWay}" PlaceholderText="Add tag" Width="160" /></StackPanel>
                            <Button Classes="ghost" Content="Tag" Command="{Binding AddTagCommand}" VerticalAlignment="Bottom" />
                            <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" VerticalAlignment="Bottom" />
                            <Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" VerticalAlignment="Bottom" />
                          </WrapPanel>
                        </Expander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Create an activity above to start tracking standalone work." Classes="muted" IsVisible="{Binding HasNoActivities}" />
            </StackPanel>
          </Border>
          </Expander>

          <Expander Header="Manage groups" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="ACTIVITY GROUPS" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding ActivityGroupAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBox Text="{Binding DraftName, Mode=TwoWay}" />
                      <Button Grid.Column="1" Classes="ghost" Content="↑" ToolTip.Tip="Move earlier" Command="{Binding MoveEarlierCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="↓" ToolTip.Tip="Move later" Command="{Binding MoveLaterCommand}" />
                      <Button Grid.Column="3" Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Grid.Column="4" Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsHistoryVisible}">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="RECENTLY TRACKED" Classes="eyebrow" />
                  <TextBlock Text="A record of time well spent." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Last 30 days" Classes="muted" FontSize="11" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" RowSpacing="9">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" FontSize="11" ><Run Text="{Binding Context}" />  ·  <Run Text="{Binding DateLabel}" /></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LaneLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontFamily="monospace" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="Correct entry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <WrapPanel Classes="editor" Orientation="Horizontal">
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Task" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding TaskOptions}" SelectedValue="{Binding SelectedTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Task" Width="360" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Activity" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding ActivityOptions}" SelectedValue="{Binding SelectedActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Activity" Width="200" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Notes" Classes="muted" FontSize="11" /><TextBox Text="{Binding NotesEditor, Mode=TwoWay}" PlaceholderText="Notes" Width="360" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Start (local time)" Classes="muted" FontSize="11" /><TextBox Text="{Binding StartText, Mode=TwoWay}" PlaceholderText="YYYY-MM-DD HH:MM" Width="300" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="End (local time)" Classes="muted" FontSize="11" /><TextBox Text="{Binding EndText, Mode=TwoWay}" PlaceholderText="YYYY-MM-DD HH:MM" Width="300" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Correction reason" Classes="muted" FontSize="11" /><TextBox Text="{Binding ReasonText, Mode=TwoWay}" PlaceholderText="Reason" Width="200" /></StackPanel>
                          <Button VerticalAlignment="Bottom" Margin="0,0,8,12" Classes="ghost" Content="Save correction" Command="{Binding CorrectCommand}" />
                        </WrapPanel>
                        </Expander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="ghost" Content="Load more history" HorizontalAlignment="Left" IsVisible="{Binding HistoryHasMore}" Command="{Binding LoadMoreHistoryCommand}" />
              <TextBlock Text="No tracked work in this range yet." Classes="muted" IsVisible="{Binding HasNoHistory}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsSummaryVisible}">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="TIME SUMMARY" Classes="eyebrow" />
                <TextBlock Text="Your time, from a different perspective." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Orientation="Horizontal" >
                <Button Classes="ghost" Content="Day" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Day" />
                <Button Classes="ghost" Content="Task" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Task" />
                <Button Classes="ghost" Content="Project" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Project" />
                <Button Classes="ghost" Content="Activity" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Activity" />
                <Button Classes="ghost" Content="Activity group" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="ActivityGroup" />
                <Button Classes="ghost" Content="Tag" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Tag" />
                <Button Classes="ghost" Content="Lane" Command="{Binding SelectSummaryGroupingCommand}" CommandParameter="Lane" />
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding SummaryItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" Margin="0,6">
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" Classes="muted" FontFamily="monospace" />
                      <TextBlock Grid.Column="2" Text="{Binding CoverageLabel}" Foreground="{DynamicResource AccentBrush}" FontFamily="monospace" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No tracked time in this range yet." Classes="muted" IsVisible="{Binding HasNoSummary}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="22" IsVisible="{Binding IsCalendarVisible}">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding CalendarRangeLabel}" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CalendarTimeZoneLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="ghost" Content="‹" AutomationProperties.Name="Previous calendar range" Command="{Binding NavigateCalendarCommand}" CommandParameter="previous" />
                  <Button Classes="ghost" Content="Today" AutomationProperties.Name="Calendar today" Command="{Binding NavigateCalendarCommand}" CommandParameter="today" />
                  <Button Classes="ghost" Content="›" AutomationProperties.Name="Next calendar range" Command="{Binding NavigateCalendarCommand}" CommandParameter="next" />
                </StackPanel>
              </Grid>
              <WrapPanel Classes="editor">
                  <Button Classes="ghost" Classes.selected="{Binding IsCalendarDay}" AutomationProperties.Name="Show calendar day" Content="Day" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Day" />
                  <Button Classes="ghost" Classes.selected="{Binding IsCalendarWeek}" AutomationProperties.Name="Show calendar week" Content="Week" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Week" />
                  <Button Classes="ghost" Classes.selected="{Binding IsCalendarMonth}" AutomationProperties.Name="Show calendar month" Content="Month" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Month" />
                  <Button Classes="ghost" Classes.selected="{Binding IsCalendarAgenda}" AutomationProperties.Name="Show calendar agenda" Content="Agenda" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Agenda" />
              </WrapPanel>
              <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding HasSelectedCalendarItem}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="5" DataContext="{Binding SelectedCalendarItem}">
                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IntervalLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Classes="primary" Content="Start planned work" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <Button Classes="ghost" Content="Close" Command="{Binding CloseCalendarItemCommand}" />
                    <Button Classes="ghost" Content="Edit in agenda" Command="{Binding SelectCalendarViewCommand}" CommandParameter="Agenda" />
                  </StackPanel>
                </Grid>
              </Border>
              <Expander Header="Add an event or plan a task" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="PLAN A TASK" Classes="eyebrow" />
                  <WrapPanel Classes="editor">
                    <ComboBox AutomationProperties.Name="Task to plan" ItemsSource="{Binding CalendarPlanTasks}" SelectedValue="{Binding CalendarPlanTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose a task" Width="260" />
                    <ComboBox AutomationProperties.Name="Calendar for planned task" ItemsSource="{Binding CalendarOptions}" SelectedValue="{Binding SelectedCalendarId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" Width="180" />
                    <TextBox AutomationProperties.Name="Planned task start" Text="{Binding CalendarPlanStartText, Mode=TwoWay}" PlaceholderText="Start (local)" Width="180" />
                    <TextBox AutomationProperties.Name="Planned task end" Text="{Binding CalendarPlanEndText, Mode=TwoWay}" PlaceholderText="End (local)" Width="180" />
                    <Button Classes="primary" AutomationProperties.Name="Plan selected task" Content="Plan task" Command="{Binding PlanNextTaskCommand}" />
                  </WrapPanel>
                  <TextBlock Text="ADD EVENT" Classes="eyebrow" />
                  <WrapPanel Classes="editor">
                    <TextBox Text="{Binding NewEventTitle, Mode=TwoWay}" PlaceholderText="Event title" Width="260" />
                    <ComboBox ItemsSource="{Binding CalendarOptions}" SelectedValue="{Binding SelectedCalendarId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Calendar" Width="180" />
                    <TextBox Text="{Binding NewEventStart, Mode=TwoWay}" PlaceholderText="Start (local, YYYY-MM-DD HH:MM)" Width="230" />
                    <TextBox Text="{Binding NewEventEnd, Mode=TwoWay}" PlaceholderText="End (local, YYYY-MM-DD HH:MM)" Width="230" />
                    <TextBox Text="{Binding NewEventDescription, Mode=TwoWay}" PlaceholderText="Description" Width="260" />
                    <TextBox Text="{Binding NewEventLocation, Mode=TwoWay}" PlaceholderText="Location" Width="180" />
                    <TextBox Text="{Binding NewEventColor, Mode=TwoWay}" PlaceholderText="#246B63" Width="120" />
                    <CheckBox Content="All day" IsChecked="{Binding NewEventAllDay, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding NewEventRecurrence, Mode=TwoWay}" PlaceholderText="Recurrence, e.g. FREQ=WEEKLY" Width="240" />
                    <TextBox Text="{Binding NewEventRecurrenceEnd, Mode=TwoWay}" PlaceholderText="Recurrence end (local, optional)" Width="240" />
                    <Button Classes="primary" Content="Add event" Command="{Binding CreateCalendarEventCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
              <local:CalendarTimeline Days="{Binding CalendarDayColumns}" IsVisible="{Binding IsCalendarTimelineVisible}" />
              <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="8" IsVisible="{Binding IsCalendarMonth}">
                <ItemsControl ItemsSource="{Binding CalendarDayColumns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding CalendarGridColumns}" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="3" Padding="8" Opacity="{Binding Opacity}" Height="112">
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding DayLabel}" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                          </Grid>
                          <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Background="{Binding Background}" CornerRadius="5" Padding="5" Margin="0,0,0,4" Command="{Binding InspectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding IntervalLabel}">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TimeLabel}" Foreground="{Binding Foreground}" FontSize="9" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Expander Header="Detailed list &amp; editing" IsExpanded="{Binding IsCalendarAgenda, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="10">
              <ItemsControl ItemsSource="{Binding CalendarBlocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="9">
                        <Border Background="{DynamicResource AccentSoftHoverBrush}" CornerRadius="8" Padding="9,7">
                          <TextBlock Text="◫" Foreground="{DynamicResource AccentBrush}" FontSize="16" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding DayLabel}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                          <TextBlock Text="{Binding DurationLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="Edit planned block" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <WrapPanel Classes="editor">
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Block title" Classes="muted" FontSize="11" /><TextBox Text="{Binding TitleEditor, Mode=TwoWay}" PlaceholderText="Title" Width="360" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Start (local time)" Classes="muted" FontSize="11" /><TextBox Text="{Binding StartText, Mode=TwoWay}" PlaceholderText="YYYY-MM-DD HH:MM" Width="300" /></StackPanel>
                          <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="End (local time)" Classes="muted" FontSize="11" /><TextBox Text="{Binding EndText, Mode=TwoWay}" PlaceholderText="YYYY-MM-DD HH:MM" Width="300" /></StackPanel>
                          <Button VerticalAlignment="Bottom" Margin="0,0,8,12" Classes="ghost" Content="Start" Command="{Binding StartCommand}" />
                          <Button VerticalAlignment="Bottom" Margin="0,0,8,12" Classes="ghost" Content="Save block" Command="{Binding UpdateCommand}" />
                        </WrapPanel>
                        </Expander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="EVENTS" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding CalendarEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource PausedSurfaceBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" />
                        <TextBlock Text="{Binding LocationLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" />
                        <TextBlock Text="{Binding DescriptionLabel}" Foreground="{DynamicResource PausedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <Expander Header="Edit event" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <WrapPanel Classes="editor">
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Title" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event title" Text="{Binding TitleEditor, Mode=TwoWay}" Width="300" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Start (local time)" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event start" Text="{Binding StartText, Mode=TwoWay}" Width="300" PlaceholderText="YYYY-MM-DD HH:MM" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="End (local time)" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event end" Text="{Binding EndText, Mode=TwoWay}" Width="300" PlaceholderText="YYYY-MM-DD HH:MM" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Description" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event description" Text="{Binding DescriptionEditor, Mode=TwoWay}" Width="300" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Location" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event location" Text="{Binding LocationEditor, Mode=TwoWay}" Width="220" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Color" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event color" Text="{Binding ColorEditor, Mode=TwoWay}" Width="130" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Recurrence" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event recurrence" Text="{Binding RecurrenceEditor, Mode=TwoWay}" Width="240" /></StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,12,12"><TextBlock Text="Recurrence end" Classes="muted" FontSize="11" /><TextBox AutomationProperties.Name="Event recurrence end" Text="{Binding RecurrenceEndText, Mode=TwoWay}" Width="260" /></StackPanel>
                            <CheckBox Content="All day" IsChecked="{Binding AllDayEditor, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,12,20" />
                            <Button Classes="ghost" Content="Save event" Command="{Binding UpdateCommand}" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                          </WrapPanel>
                        </Expander>
                        <Button Classes="ghost" AutomationProperties.Name="Delete calendar event" Content="Delete event" HorizontalAlignment="Left" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No planned blocks in this range." Classes="muted" IsVisible="{Binding HasNoCalendarBlocks}" />
              </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding IsSettingsVisible}">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="YOUR DATA" Classes="eyebrow" />
              <TextBlock Text="Back up, export, or recover your local workspace." Classes="muted" TextWrapping="Wrap" />
              <WrapPanel Classes="editor">
                <Button Classes="primary" AutomationProperties.Name="Create verified backup" Content="Create backup" Command="{Binding BackupCommand}" />
                <Button Classes="ghost" AutomationProperties.Name="Export workspace JSON" Content="Export JSON" Command="{Binding ExportCommand}" />
                <Button Classes="ghost" AutomationProperties.Name="Export CSV worklog" Content="Export worklog CSV" Command="{Binding ExportCsvCommand}" />
                <Button Classes="ghost" AutomationProperties.Name="Restore latest backup" Content="Restore latest backup" Command="{Binding RestoreCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Expander Header="Boards" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="BOARDS" Classes="eyebrow" />
                <TextBlock Text="Give each area of your life a home." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewBoardName, Mode=TwoWay}" PlaceholderText="New board name" Padding="9" />
                <Button Grid.Column="1" Classes="primary" Content="Create board" Command="{Binding CreateBoardCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding BoardAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBox Text="{Binding DraftName, Mode=TwoWay}" Padding="8" />
                      <Button Grid.Column="1" Classes="ghost" Content="↑" ToolTip.Tip="Move earlier" Command="{Binding MoveEarlierCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="↓" ToolTip.Tip="Move later" Command="{Binding MoveLaterCommand}" />
                      <Button Grid.Column="3" Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Grid.Column="4" Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" />
                      <Button Grid.Column="5" Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>
          <Expander Header="Projects" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="PROJECTS" Classes="eyebrow" />
                <TextBlock Text="Create focused places for work, then move tasks between them." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Boards}" SelectedValue="{Binding SelectedBoardId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Board" Padding="9" />
                <TextBox Grid.Column="1" Text="{Binding NewProjectName, Mode=TwoWay}" PlaceholderText="New project name" Width="220" Padding="9" />
                <Button Grid.Column="2" Classes="primary" Content="Create project" Command="{Binding CreateProjectCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProjectAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                    <WrapPanel Classes="editor">
                      <TextBox Width="240" Text="{Binding DraftName, Mode=TwoWay}" Padding="8" />
                      <TextBox Width="150" Text="{Binding TagText, Mode=TwoWay}" PlaceholderText="Add tag" Padding="8" />
                      <Button Classes="ghost" Content="Tag" Command="{Binding AddTagCommand}" />
                      <Button Classes="ghost" Content="↑" ToolTip.Tip="Move earlier" Command="{Binding MoveEarlierCommand}" />
                      <Button Classes="ghost" Content="↓" ToolTip.Tip="Move later" Command="{Binding MoveLaterCommand}" />
                      <Button Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" />
                      <Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>

          <Expander Header="Activities &amp; groups" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="ACTIVITIES" Classes="eyebrow" />
                <TextBlock Text="Name the kinds of work you want to track." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewActivityGroupName, Mode=TwoWay}" PlaceholderText="New activity group" Padding="9" />
                <Button Grid.Column="1" Classes="ghost" Content="Create group" Command="{Binding CreateActivityGroupCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ActivityGroupAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBox Text="{Binding DraftName, Mode=TwoWay}" Padding="8" />
                      <Button Grid.Column="1" Classes="ghost" Content="↑" ToolTip.Tip="Move earlier" Command="{Binding MoveEarlierCommand}" />
                      <Button Grid.Column="2" Classes="ghost" Content="↓" ToolTip.Tip="Move later" Command="{Binding MoveLaterCommand}" />
                      <Button Grid.Column="3" Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Grid.Column="4" Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewActivityName, Mode=TwoWay}" PlaceholderText="New activity name" Padding="9" />
                <Button Grid.Column="1" Classes="primary" Content="Create activity" Command="{Binding CreateActivityCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ActivityAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                    <WrapPanel Classes="editor">
                      <TextBox Width="240" Text="{Binding DraftName, Mode=TwoWay}" Padding="8" />
                      <ComboBox Width="180" ItemsSource="{Binding GroupOptions}" SelectedValue="{Binding GroupId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Activity group" Padding="8" />
                      <TextBox Width="150" Text="{Binding TagText, Mode=TwoWay}" PlaceholderText="Add tag" Padding="8" />
                      <Button Classes="ghost" Content="Tag" Command="{Binding AddTagCommand}" />
                      <Button Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" />
                      <Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>
          <Expander Header="Calendars" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="CALENDARS" Classes="eyebrow" />
              <TextBlock Text="Keep planned blocks and user events in named, color-coded calendars." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewCalendarName, Mode=TwoWay}" PlaceholderText="New calendar name" />
                <TextBox Grid.Column="1" Text="{Binding NewCalendarColor, Mode=TwoWay}" PlaceholderText="#246B63" />
                <Button Grid.Column="2" Classes="primary" Content="Create" Command="{Binding CreateCalendarCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding CalendarAdminRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,140,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBox Text="{Binding DraftName, Mode=TwoWay}" Padding="8" />
                      <TextBox Grid.Column="1" Text="{Binding DraftColor, Mode=TwoWay}" Padding="8" />
                      <CheckBox Grid.Column="2" Content="Visible" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Classes="ghost" Content="Save" Command="{Binding SaveCommand}" />
                      <Button Grid.Column="4" Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="TIMER BEHAVIOR" Classes="eyebrow" />
              <TextBlock Text="Choose whether starting a focus timer may leave another focus timer running." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <CheckBox Content="Allow concurrent foreground timers" IsChecked="{Binding AllowConcurrentForeground, Mode=TwoWay}" />
              <Button Classes="primary" Content="Save timer setting" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
          </Border>
          <Expander Header="Deleted events" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasDeletedCalendarEvents}">
          <Border Classes="card" IsVisible="{Binding HasDeletedCalendarEvents}">
            <StackPanel Spacing="10">
              <TextBlock Text="DELETED EVENTS" Classes="eyebrow" />
              <TextBlock Text="Restore calendar events without changing their identity." Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding DeletedCalendarEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLabel}" Classes="muted" FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="Restore" Command="{Binding RestoreCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </Expander>
        </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="muted" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
    <Grid Grid.ColumnSpan="2" Background="#4020263D" IsVisible="{Binding IsTaskEditorOpen}">
      <Border x:Name="TaskDrawer" Width="450" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" Padding="24" BoxShadow="-8 0 32 0 #2020263D" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="TASK DETAILS" Classes="eyebrow" />
              <TextBlock Text="Make the next step clear" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CloseTaskEditorCommand}" AutomationProperties.Name="Cancel task editing" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
              <StackPanel Spacing="12" DataContext="{Binding TaskEditor}">
                <StackPanel Spacing="5">
                  <TextBlock Text="Title" Classes="muted" FontSize="12" />
                  <TextBox x:Name="TaskEditorTitle" AutomationProperties.Name="Task editor title" Text="{Binding DraftTitle, Mode=TwoWay}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="5">
                  <TextBlock Text="Description" Classes="muted" FontSize="12" />
                  <TextBox AutomationProperties.Name="Task editor description" Text="{Binding DraftDescription, Mode=TwoWay}" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="What does done look like?" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="5"><TextBlock Text="Priority" Classes="muted" FontSize="12" /><ComboBox AutomationProperties.Name="Task editor priority" ItemsSource="{Binding PriorityOptions}" SelectedValue="{Binding DraftPriority, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Deadline" Classes="muted" FontSize="12" /><TextBox AutomationProperties.Name="Task editor deadline" Text="{Binding DueDateText, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" /></StackPanel>
                </Grid>
                <StackPanel Spacing="5"><TextBlock Text="Default activity" Classes="muted" FontSize="12" /><ComboBox ItemsSource="{Binding ActivityOptions}" SelectedValue="{Binding DraftActivityId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose activity" /></StackPanel>
                <CheckBox Content="Star this task" IsChecked="{Binding DraftStarred, Mode=TwoWay}" />
                <TextBlock Text="The actions below apply immediately. Save task stores your title, description, and options above." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <Expander Header="Move to another project" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <ComboBox AutomationProperties.Name="Move task to project" ItemsSource="{Binding ProjectOptions}" SelectedValue="{Binding TargetProjectId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" />
                    <Button Classes="ghost" Content="Move to project" Command="{Binding MoveCommand}" />
                  </StackPanel>
                </Expander>
                <Expander Header="Tags, dependencies &amp; references" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <TextBox Text="{Binding TagText, Mode=TwoWay}" PlaceholderText="Tag" />
                    <Button Classes="ghost" Content="Add tag" Command="{Binding AddTagCommand}" />
                    <ComboBox ItemsSource="{Binding PrerequisiteOptions}" SelectedValue="{Binding PrerequisiteTaskId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Prerequisite task" />
                    <Button Classes="ghost" Content="Add prerequisite" Command="{Binding AddDependencyCommand}" />
                    <TextBox Text="{Binding LinkLabelText, Mode=TwoWay}" PlaceholderText="Reference label" />
                    <TextBox Text="{Binding LinkUriText, Mode=TwoWay}" PlaceholderText="https:// or file://" />
                    <Button Classes="ghost" Content="Add reference" Command="{Binding AddLinkCommand}" />
                  </StackPanel>
                </Expander>
                <Expander Header="Archive &amp; recovery" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <WrapPanel Classes="editor">
                    <Button Classes="ghost" Content="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}" />
                    <Button Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                  </WrapPanel>
                </Expander>
              </StackPanel>
              <StackPanel DataContext="{Binding SelectedTaskDetails}" Spacing="8">
                <TextBlock Text="{Binding TrackedLabel}" Classes="muted" />
                <TextBlock Text="{Binding PrerequisiteLabel}" Classes="muted" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Classes="muted" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl ItemsSource="{Binding Links}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Uri}" Classes="muted" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Text="Save your edits, or Cancel to discard them." Classes="muted" FontSize="11" />
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Button Classes="primary" Content="Save task" AutomationProperties.Name="Save task editor" Command="{Binding TaskEditor.SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Canvas x:Name="BoardDragOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False">
      <Border x:Name="BoardDragPreview" Classes="task-card" Width="260" Padding="18" BoxShadow="0 12 28 0 #3320263D">
        <StackPanel Spacing="10">
          <TextBlock Text="MOVING TASK" Classes="eyebrow" Foreground="{DynamicResource RunningBrush}" />
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Drop on a project · Esc to cancel" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>
