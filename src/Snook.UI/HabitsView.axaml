<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Snook.UI" x:Class="Snook.UI.HabitsView"
             x:DataType="local:MainWindowViewModel" x:CompileBindings="True">
  <UserControl.Resources>
    <DataTemplate x:Key="HabitDayTemplate" x:DataType="local:HabitDayViewModel">
      <Button Classes="secondary habit-day" Classes.done="{Binding Completed}" Command="{Binding ToggleCommand}"
              AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding Detail}" Margin="0,0,6,6" Width="76" Padding="4,9">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="{Binding DateLabel}" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="StackPanel.habit-row-actions"><Setter Property="Grid.Column" Value="1" /></Style>
    <Style Selector="local|HabitsView.narrow StackPanel.habit-row-actions">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="local|HabitsView.narrow StackPanel.habit-title"><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
    <Style Selector="local|HabitsView.narrow CheckBox"><Setter Property="MinHeight" Value="48" /></Style>
    <Style Selector="Button.habit-day.done">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.habit-row.deleted"><Setter Property="BorderBrush" Value="#A14444" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <Grid x:Name="HabitHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <TextBlock Text="Small routines, one day at a time." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="HabitNewButton" Grid.Column="1" Classes="primary" Content="+ New habit" Command="{Binding NewHabitCommand}" AutomationProperties.Name="New habit" />
    </Grid>
    <WrapPanel>
      <CheckBox Content="Show archived" IsChecked="{Binding ShowArchivedHabits}" Margin="0,0,18,0" AutomationProperties.Name="Show archived habits" />
      <CheckBox Content="Show deleted" IsChecked="{Binding ShowDeletedHabits}" AutomationProperties.Name="Show deleted habits" />
    </WrapPanel>
    <Grid x:Name="HabitDateToolbar" ColumnDefinitions="250,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
      <StackPanel x:Name="HabitDateInput" Spacing="5">
        <TextBlock Text="History through · YYYY-MM-DD" Classes="field-label" />
        <TextBox x:Name="HabitThroughField" Text="{Binding HabitThroughText}" PlaceholderText="Today in each habit's time zone" AutomationProperties.Name="Habit history through date" />
      </StackPanel>
      <Button x:Name="HabitViewDateButton" Grid.Column="1" Classes="secondary" Content="View date" Command="{Binding ApplyHabitDateCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="View habit history date" />
      <Button x:Name="HabitTodayButton" Grid.Column="2" Classes="ghost" Content="Today" Command="{Binding HabitTodayCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="Habit history today" />
    </Grid>
    <Border Classes="card" IsVisible="{Binding HasNoHabits}">
      <StackPanel Spacing="8">
        <TextBlock Text="Make room for a daily habit" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Read a little, take a walk, or practice something. Add a habit, then check off each day you do it." Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Archived and deleted habits keep their history. Use the filters above to restore them." Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Habits}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:HabitRowViewModel">
          <Border Classes="card habit-row" Classes.deleted="{Binding IsDeleted}" Margin="0,0,0,12" Padding="18">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <StackPanel Classes="habit-title" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StateLabel}" Classes="eyebrow" />
                </StackPanel>
                <StackPanel Classes="habit-row-actions" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                  <Button Classes="ghost" Content="Edit" Command="{Binding EditCommand}" IsVisible="{Binding IsActive}" AutomationProperties.Name="{Binding EditName}" />
                  <Button Classes="ghost" Content="More" AutomationProperties.Name="Habit actions">
                    <Button.Flyout><MenuFlyout>
                      <MenuItem Header="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}" IsVisible="{Binding CanArchive}" AutomationProperties.Name="{Binding ArchiveName}" />
                      <MenuItem Header="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding DeleteName}" />
                    </MenuFlyout></Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProgressLabel}" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RangeLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding RecentDays}" ItemTemplate="{StaticResource HabitDayTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <Expander Header="Earlier days in this 30-day view" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding EarlierDays}" ItemTemplate="{StaticResource HabitDayTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Select a day to check it off or undo it. You can correct the last 366 days. An unfinished today keeps yesterday's streak until the day ends." Classes="muted" FontSize="12" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
