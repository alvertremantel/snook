<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original vectors on a shared 24-unit grid. Inherited foreground keeps
         the icons in step with the navigation label in every button state. -->
    <ControlTheme x:Key="NavigationIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style Selector="^ /template/ Path.outline">
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="HabitsNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Classes="outline" Data="M19.5 7 A8.5 8.5 0 1 0 20.5 13 M16 3.5 L20 7 L21 2.5 M8 12 L11 15 L16 9" Stroke="{TemplateBinding Foreground}" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <StreamGeometry x:Key="TodayIconBody">M17 12 A5 5 0 1 1 7 12 A5 5 0 1 1 17 12 Z</StreamGeometry>
    <ControlTheme x:Key="TodayNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource TodayIconBody}" Fill="{TemplateBinding Foreground}" Opacity="0.16" />
                    <Path Classes="outline" Data="{StaticResource TodayIconBody}" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M12 2 V3.5 M12 20.5 V22 M2 12 H3.5 M20.5 12 H22 M4.9 4.9 L6 6 M18 18 L19.1 19.1 M4.9 19.1 L6 18 M18 6 L19.1 4.9" Stroke="{TemplateBinding Foreground}" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="TasksIconBody">M6 3.5 H18 Q20.5 3.5 20.5 6 V18 Q20.5 20.5 18 20.5 H6 Q3.5 20.5 3.5 18 V6 Q3.5 3.5 6 3.5 Z</StreamGeometry>
    <ControlTheme x:Key="TasksNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource TasksIconBody}" Fill="{TemplateBinding Foreground}" Opacity="0.10" />
                    <Path Classes="outline" Data="{StaticResource TasksIconBody}" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M6.7 8.2 L8 9.5 L10.3 7 M6.7 14.7 L8 16 L10.3 13.5" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M13 8.5 H17 M13 15 H17" Stroke="{TemplateBinding Foreground}" Opacity="0.7" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="TrackerIconBody">M20 13.5 A8 8 0 1 1 4 13.5 A8 8 0 1 1 20 13.5 Z</StreamGeometry>
    <ControlTheme x:Key="TrackerNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="M12 5.5 A8 8 0 0 1 20 13.5 H12 Z" Fill="{TemplateBinding Foreground}" Opacity="0.18" />
                    <Path Classes="outline" Data="{StaticResource TrackerIconBody}" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M9.5 2 H14.5 M12 2 V5.5 M18 7.5 L20 5.5 M19 4.5 L21 6.5 M12 13.5 L15.2 10.3" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M7 13.5 H7.5 M12 18 V18.5" Stroke="{TemplateBinding Foreground}" Opacity="0.65" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="CalendarIconBody">M5.5 4.5 H18.5 Q21 4.5 21 7 V18 Q21 20.5 18.5 20.5 H5.5 Q3 20.5 3 18 V7 Q3 4.5 5.5 4.5 Z</StreamGeometry>
    <ControlTheme x:Key="CalendarNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="M5.5 4.5 H18.5 Q21 4.5 21 7 V9 H3 V7 Q3 4.5 5.5 4.5 Z M10.8 15.8 H13.2 V18.2 H10.8 Z" Fill="{TemplateBinding Foreground}" Opacity="0.22" />
                    <Path Classes="outline" Data="{StaticResource CalendarIconBody}" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M7.5 2.5 V6.5 M16.5 2.5 V6.5 M3 9 H21" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M7 13 H7.5 M11.75 13 H12.25 M16.5 13 H17 M7 17 H7.5 M16.5 17 H17" Stroke="{TemplateBinding Foreground}" Opacity="0.8" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="HistoryIconBody">M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 Z</StreamGeometry>
    <ControlTheme x:Key="HistoryNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource HistoryIconBody}" Fill="{TemplateBinding Foreground}" Opacity="0.10" />
                    <Path Classes="outline" Data="M3.8 8 A8.5 8.5 0 1 1 3.5 14.5 M3 3.5 V8.5 H8" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M12 7.5 V12 L15 14" Stroke="{TemplateBinding Foreground}" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="SummaryIconBody">M4 12.5 Q4 12 4.5 12 H7 Q7.5 12 7.5 12.5 V20 H4 Z M10.25 5.5 Q10.25 5 10.75 5 H13.25 Q13.75 5 13.75 5.5 V20 H10.25 Z M16.5 9 Q16.5 8.5 17 8.5 H19.5 Q20 8.5 20 9 V20 H16.5 Z</StreamGeometry>
    <ControlTheme x:Key="SummaryNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource SummaryIconBody}" Fill="{TemplateBinding Foreground}" Opacity="0.16" />
                    <Path Data="M10.25 5 H13.75 V20 H10.25 Z" Fill="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Path Classes="outline" Data="{StaticResource SummaryIconBody}" Stroke="{TemplateBinding Foreground}" />
                    <Path Classes="outline" Data="M2.5 20 H21.5" Stroke="{TemplateBinding Foreground}" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <StreamGeometry x:Key="SettingsIconBody">M10 2.5 H14 L14.6 5 L16.1 5.9 L18.6 5.1 L20.6 8.5 L18.8 10.4 V13.6 L20.6 15.5 L18.6 18.9 L16.1 18.1 L14.6 19 L14 21.5 H10 L9.4 19 L7.9 18.1 L5.4 18.9 L3.4 15.5 L5.2 13.6 V10.4 L3.4 8.5 L5.4 5.1 L7.9 5.9 L9.4 5 Z M15.25 12 A3.25 3.25 0 1 1 8.75 12 A3.25 3.25 0 1 1 15.25 12 Z</StreamGeometry>
    <ControlTheme x:Key="SettingsNavigationIcon" TargetType="ContentControl" BasedOn="{StaticResource NavigationIcon}">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource SettingsIconBody}" Fill="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Path Classes="outline" Data="{StaticResource SettingsIconBody}" Stroke="{TemplateBinding Foreground}" />
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
