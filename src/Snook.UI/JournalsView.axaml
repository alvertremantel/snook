<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Snook.UI" x:Class="Snook.UI.JournalsView"
             x:DataType="local:MainWindowViewModel" x:CompileBindings="True">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock Text="YOUR JOURNALS" Classes="eyebrow" />
        <ComboBox ItemsSource="{Binding JournalOptions}" SelectedValue="{Binding SelectedJournalId}" SelectedValueBinding="{Binding Id}"
                  DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Left" Width="300" AutomationProperties.Name="Choose journal" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="secondary" Content="New journal" Command="{Binding NewJournalCommand}" AutomationProperties.Name="New journal" />
        <Button Classes="primary" Content="+ Write an entry" Command="{Binding NewJournalEntryCommand}" IsEnabled="{Binding CanWriteJournalEntry}" AutomationProperties.Name="Write journal entry" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding JournalContext}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ghost" Content="Journal settings" IsVisible="{Binding CanManageJournal}" AutomationProperties.Name="Journal settings">
        <Button.Flyout><MenuFlyout>
          <MenuItem Header="Edit journal" Command="{Binding EditJournalCommand}" IsEnabled="{Binding CanEditJournal}" AutomationProperties.Name="Edit selected journal" />
          <MenuItem Header="{Binding JournalDeleteLabel}" Command="{Binding DeleteJournalCommand}" AutomationProperties.Name="Delete or restore selected journal" />
        </MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding JournalSearch}" MaxLength="200" PlaceholderText="Search your entries" AutomationProperties.Name="Search journal entries" />
          <TextBox Grid.Column="1" Text="{Binding JournalTag}" MaxLength="50" PlaceholderText="Filter by journal tag" AutomationProperties.Name="Filter journal tag" />
          <Button Grid.Column="2" Classes="secondary" Content="Apply" Command="{Binding FilterJournalEntriesCommand}" AutomationProperties.Name="Apply journal filters" />
        </Grid>
        <CheckBox Content="Show deleted" IsChecked="{Binding ShowDeletedJournalItems}" AutomationProperties.Name="Show deleted journal items" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasNoJournals}" Padding="32">
      <StackPanel Spacing="12" MaxWidth="490" HorizontalAlignment="Left">
        <TextBlock Text="A place for what’s on your mind" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="The small wins, the unfinished thoughts, the things you want to remember. Start a journal and make it yours." Classes="muted" TextWrapping="Wrap" LineHeight="23" />
        <Button Classes="primary" Content="Create your first journal" Command="{Binding NewJournalCommand}" AutomationProperties.Name="Create first journal" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasNoJournalEntries}" Padding="28">
      <StackPanel Spacing="8">
        <TextBlock Text="Room for a new reflection" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="Write an entry to begin, or adjust your filters to revisit earlier words." Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding JournalEntries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:JournalEntryRowViewModel">
          <Border Classes="card journal-entry" Padding="24" Margin="0,0,0,14">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding JournalName}" Classes="eyebrow" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DateLabel}" Classes="muted" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                  <TextBlock Text="{Binding MoodLabel}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ContentPreview}" FontSize="14" LineHeight="23" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TagLabel}" IsVisible="{Binding HasTags}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DeletedLabel}" IsVisible="{Binding IsDeleted}" FontSize="12" Foreground="{DynamicResource PausedBrush}" />
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="ghost" Content="{Binding OpenLabel}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding OpenName}" />
                <Button Grid.Column="1" Classes="ghost" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanRestoreOrDelete}" AutomationProperties.Name="{Binding DeleteName}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="secondary" Content="Load earlier entries" Command="{Binding MoreJournalEntriesCommand}" IsVisible="{Binding HasMoreJournalEntries}"
            HorizontalAlignment="Center" AutomationProperties.Name="Load more journal entries" />
  </StackPanel>
</UserControl>
